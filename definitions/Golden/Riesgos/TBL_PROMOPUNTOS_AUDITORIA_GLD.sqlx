config {
  type: "table",
  database: databases.golden,
  schema: "GLD_RIESGOS",
  name: "TBL_PROMOPUNTOS_AUDITORIA_GLD",
  bigquery: {
    clusterBy: ["HOJA", "FECHA"]
  },
  tags: ["carga_full_mensual_golden_archivos"]
}

SELECT
  'Dubai_Palace' AS HOJA,
  FECHA,
  SALA,
  PROVEEDOR_PROMOPUNTOS,
  NOMBRE_PROMOPUNTOS,
  ID_EN_PLANTA_PROMOPUNTOS,
  INICIADA_PROMOPUNTOS,
  FINALIZADA_PROMOPUNTOS,
  DURACION_PROMOPUNTOS,
  ESTADO_PROMOPUNTOS,
  NUMERO_PROMOPUNTOS,
  TITULAR_PROMOPUNTOS,
  TOTAL_IN_PROMOPUNTOS,
  JUGADO_PROMOPUNTOS,
  GANADO_PROMOPUNTOS,
  TOTAL_OUT_PROMOPUNTOS,
  NETWIN_PROMOPUNTOS,
  CALCULADOS_PROMOPUNTOS,
  ASIGNADOS_PROMOPUNTOS,
  INGESTION_TS
FROM ${ref(databases.stage, "STG_DATASET_ARCHIVOS", "TBL_PROMOPUNTOS_AUDITORIA_DUBAI_PALACE_STG")}
UNION ALL
