config {
  type: "table",
  database: databases.golden,
  schema: "GLD_RIESGOS",
  name: "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_GLD",
  bigquery: {
    clusterBy: ["HOJA", "FECHA"]
  },
  tags: ["carga_full_mensual_golden_archivos"]
}

SELECT
  'DUBAI_PALACE' AS HOJA,
  FECHA,
  CASINO,
  INSPECTOR,
  JUEGO,
  MESA,
  INCIDENCIA,
  TIPO_DE_INCIDENCIA,
  NIVEL_DE_RIESGO,
  DEALER,
  JEFE_INMEDIATO,
  GERENTE_EN_TURNO,
  TIEMPOS_DE_VERIFICACION,
  DETECCION,
  PROCESO,
  ENCONTRA,
  RECUPERADO,
  A_FAVOR,
  PAGADO,
  NUM_CLIENTES,
  FRECUENCIA,
  TIEMPO,
  PACER,
  PUNTOS,
  CTW,
  INGESTION_TS
FROM ${ref(databases.stage, "STG_DATASET_ARCHIVOS", "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_DUBAI_PALACE_STG")}
UNION ALL
