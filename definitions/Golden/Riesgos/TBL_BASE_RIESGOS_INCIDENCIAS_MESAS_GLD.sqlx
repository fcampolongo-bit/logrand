config {
  type: "table",
  database: databases.golden,
  schema: "GLD_RIESGOS",
  name: "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_GLD",
  bigquery: {
    clusterBy: ["HOJA", "Fecha"]
  },
  tags: ["carga_full_mensual_golden_archivos"]
}

SELECT
  'DUBAI_PALACE' AS HOJA,
  Fecha,
  Casino,
  Inspector,
  Juego,
  Mesa,
  Incidencia,
  Tipo_de_Incidencia,
  Nivel_de_Riesgo,
  Dealer,
  Jefe_inmediato,
  Gerente_en_turno,
  Tiempos_de_Verificacion,
  Deteccion,
  Proceso,
  Encontra,
  Recuperado,
  A_Favor,
  Pagado,
  Num_clientes,
  Frecuencia,
  Tiempo,
  PACER,
  Puntos,
  CTW,
  INGESTION_TS
FROM ${ref(databases.stage, "STG_DATASET_ARCHIVOS", "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_DUBAI_PALACE_STG")}
UNION ALL
SELECT
  'GOLDEN_ISLAND' AS HOJA,
  Fecha,
  Casino,
  Inspector,
  Juego,
  Mesa,
  Incidencia,
  Tipo_de_Incidencia,
  Nivel_de_Riesgo,
  Dealer,
  Jefe_inmediato,
  Gerente_en_turno,
  SAFE_CAST(Tiempos_de_Verificacion AS STRING) AS Tiempos_de_Verificacion,
  Deteccion,
  Proceso,
  Encontra,
  Recuperado,
  A_Favor,
  Pagado,
  Num_clientes,
  Frecuencia,
  Tiempo,
  PACER,
  Puntos,
  CTW,
  INGESTION_TS
FROM ${ref(databases.stage, "STG_DATASET_ARCHIVOS", "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_GOLDEN_ISLAND_STG")}
UNION ALL
