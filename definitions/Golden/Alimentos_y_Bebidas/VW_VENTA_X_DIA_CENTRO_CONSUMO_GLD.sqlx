config {
  type: "view",
  database: databases.golden,
  schema: "GLD_ALIMENTOS_Y_BEBIDAS",
  name: "VW_VENTA_X_DIA_CENTRO_CONSUMO_GLD"
}

SELECT
  K_VENTA_X_DIA_CENTRO_CONSUMO,
  F_FECHA,
  D_LOCALIZACION,
  D_CENTRO_CONSUMO,
  M_VENTAS_NETAS,
  N_DESCUENTOS,
  N_SERVICE_CHARGE,
  N_IMPUESTOS,
  F_MODIFICACION,
  CURRENT_TIMESTAMP() AS ingestion_ts
FROM
  ${ref("STG_INTERFACES", "TBL_VENTA_X_DIA_CENTRO_CONSUMO_STG")}
