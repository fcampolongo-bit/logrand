  `GM-Simpho`,
  `GM-Simpho Nombre`,
  `FM-Simpho`,
  `FM-Simpho Nombre`,
  ingestion_ts
FROM
  ${ref("STG_SIMPHONY", "TBL_BASE_MAESTRA_MICROS_SIMPHONY_STG")}