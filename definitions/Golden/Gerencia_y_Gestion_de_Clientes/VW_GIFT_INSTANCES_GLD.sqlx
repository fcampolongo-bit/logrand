config {
  type: "view",
  database: databases.golden,
  schema: "GLD_GERENCIA_Y_GESTION_DE_CLIENTES",
  name: "VW_GIFT_INSTANCES_GLD",
  tags: ["carga_incremental_diaria_golden_lote2"]
}

${salas.lista_salas.map(s => `
  SELECT
    *,
    '${s.nombre}' AS sala,
    ${s.id} AS id_sala
  FROM
    ` + ref(s.esquema, "TBL_GIFT_INSTANCES_STG") + `
`).join("\n UNION ALL \n")}