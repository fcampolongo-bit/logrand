config {
  type: "incremental",
  database: databases.golden, 
  schema: "GLD_REPORTE_TRANSITORIO",
  name: "TBL_ACCOUNTS_CLIENTE_UNICO_GLD",
  bigquery: {
    partitionBy: "DATETIME_TRUNC(Fecha_Alta, MONTH)",
    clusterBy: ["ID_Alta"]
  },
  tags: ["carga_full_diaria_bi"],
  protected: true
}

-- Limpia los datos sin eliminar la tabla física para preservar el ID interno y mantener activa la Vista Materializada
pre_operations {
  DELETE FROM ${self()} WHERE TRUE
}

WITH sala_origen AS (
  SELECT DISTINCT 
    ac_account_id,
    CASE 
      WHEN RIGHT(CAST(ac_account_id AS STRING), 3) = '205' THEN '095'
      ELSE RIGHT(CAST(ac_account_id AS STRING), 3)
    END AS sala_origen 
  FROM ${ref("VW_ACCOUNTS_GLD")}
  WHERE ac_holder_gender IS NOT NULL
)

SELECT 
  a.ac_account_id AS Num_Cliente,
  ac_holder_name AS Titular,
  CASE 
    WHEN ac_holder_email_01 LIKE '%@CORREO%' 
      OR ac_holder_email_01 LIKE '%NOTIENE%'
      OR ac_holder_email_01 LIKE '%REGIN@GMAIL.COM%' 
      OR ac_holder_email_01 LIKE '%SINCORREO%' THEN 'NOTIENE@CORREO.COM'
    ELSE ac_holder_email_01 
  END AS Correo,
  ac_holder_phone_number_01 AS Telefono1,
  ac_holder_phone_number_02 AS Telefono2,
  CASE 
    WHEN ac_holder_gender = 1 THEN 'Hombre' 
    WHEN ac_holder_gender = 2 THEN 'Mujer' 
    ELSE 'No Informado'
  END AS Genero,
  ac_holder_birth_date AS Fecha_Nacimiento,
  ac_holder_name1 AS Apellido1,
  ac_holder_name2 AS Apellido2,
  ac_holder_name3 AS Nombre,
  CASE 
    WHEN RIGHT(CAST(b.ac_account_id AS STRING), 3) = '205' THEN 'PROVIDENS'
    ELSE c.sala_carga 
  END AS Sala_Alta,
  CAST(RIGHT(CAST(b.ac_account_id AS STRING), 3) AS INT) AS ID_Alta,
  CONCAT(
    RIGHT(CAST(b.ac_account_id AS STRING), 3), 
    '-',
    CASE 
      WHEN RIGHT(CAST(b.ac_account_id AS STRING), 3) = '205' THEN 'PROVIDENS'
      ELSE c.sala_carga 
    END
  ) AS Codigo,
  ac_created AS Fecha_Alta,
  CASE 
    WHEN ac_holder_level = 1 THEN 'Classic'
    WHEN ac_holder_level = 2 THEN 'Gold'
    WHEN ac_holder_level = 3 THEN 'Platinum'
    WHEN ac_holder_level = 4 THEN 'Diamond'
    WHEN ac_holder_level = 5 THEN 'Black'
    WHEN ac_holder_level = 6 THEN 'The One'
    ELSE NULL 
  END AS Nivel,
  DATE_DIFF(CURRENT_DATE(), EXTRACT(DATE FROM ac_holder_birth_date), YEAR) 
    - IF(
        EXTRACT(MONTH FROM CURRENT_DATE()) < EXTRACT(MONTH FROM ac_holder_birth_date) 
        OR (
          EXTRACT(MONTH FROM CURRENT_DATE()) = EXTRACT(MONTH FROM ac_holder_birth_date) 
          AND EXTRACT(DAY FROM CURRENT_DATE()) < EXTRACT(DAY FROM ac_holder_birth_date)
        ), 1, 0
      ) AS Edad

FROM ${ref("VW_ACCOUNTS_GLD")} a
JOIN sala_origen b
  ON a.ac_account_id = b.ac_account_id
  AND a.id_sala = CAST(b.sala_origen AS INT)
JOIN ${ref("TBL_CATALOGO_SALA_GLD")} c
  ON CAST(b.sala_origen AS INT) = c.id_sala

WHERE ac_holder_gender IS NOT NULL
  AND a.ac_created IS NOT NULL
  AND DATE(a.ac_created) >= '2015-01-01'