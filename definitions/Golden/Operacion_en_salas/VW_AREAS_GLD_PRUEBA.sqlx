config {
  type: "view",
  database: databases.golden,
  schema: "DATASET_PRUEBA",
  name: "VW_AREAS_GLD_PRUEBA",
  tags: ["prueba_areas_golden"]
}

SELECT
  *,
  'JUBILEE_PRUEBA' AS sala,
  95 AS id_sala

FROM
  ${ref(
    databases.stage,
    "DATASET_PRUEBA",
    "TBL_AREAS_STG_PRUEBA"
  )}