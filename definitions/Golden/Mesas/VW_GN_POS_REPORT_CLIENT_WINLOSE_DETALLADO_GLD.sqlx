config {
  type: "view",
  database: databases.golden,
  schema: "GLD_MESAS",
  name: "VW_GN_POS_REPORT_CLIENT_WINLOSE_DETALLADO_GLD"
}

${salas.lista_salas
  .filter(s =>
    [
      "STG_WIGOS_CONSTITUCION",
      "STG_WIGOS_DUBAI",
      "STG_WIGOS_ESTANZUELA",
      "STG_WIGOS_GOLDENISLAND",
      "STG_WIGOS_GRANDJUBILEE",
      "STG_WIGOS_GRANDLEON",
      "STG_WIGOS_GUASAVE",
      "STG_WIGOS_JUBILEE",
      "STG_WIGOS_NEWYORK",
      "STG_WIGOS_PARADISE",
      "STG_WIGOS_TAJMAHAL",
      "STG_WIGOS_VIVAMEXICO",
      "STG_WIGOS_VIVENTO",
      "STG_WIGOS_VIVENTO4RIOS",
      "STG_WIGOS_ZAPOPAN"
    ].includes(s.esquema)
  )
  .map(s => `
  SELECT
    *,
    '${s.nombre}' AS sala,
    ${s.id} AS id_sala
  FROM
    ` + ref(s.esquema, "TBL_GN_POS_REPORT_CLIENT_WINLOSE_DETALLADO_STG") + `
`).join("\nUNION ALL\n")}