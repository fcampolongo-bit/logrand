config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_MODIFICACIONES_SISTEMA_WIGOS_PROVEEDOR_STG",
  bigquery: {
    clusterBy: ["FECHA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Fecha AS DATE) AS FECHA,
  SAFE_CAST(Proveedor AS STRING) AS PROVEEDOR,
  SAFE_CAST(Numero_de_correcciones_estadisticas AS INT64) AS NUMERO_DE_CORRECCIONES_ESTADISTICAS,
  ROUND(SAFE_CAST(Suma_de_Modificacion_Coin_In AS NUMERIC), 4) AS SUMA_DE_MODIFICACION_COIN_IN,
  ROUND(SAFE_CAST(Suma_de_Modificacion_Coin_Out AS NUMERIC), 4) AS SUMA_DE_MODIFICACION_COIN_OUT,
  SAFE_CAST(Suma_de_Modificacion_Jugadas AS INT64) AS SUMA_DE_MODIFICACION_JUGADAS,
  SAFE_CAST(Fecha_1 AS DATE) AS FECHA_1,
  SAFE_CAST(Proveedor_1 AS STRING) AS PROVEEDOR_1,
  SAFE_CAST(ROUND(SAFE_CAST(Numero_de_correcciones_sesiones AS NUMERIC)) AS INT64) AS NUMERO_DE_CORRECCIONES_SESIONES,
  ROUND(SAFE_CAST(Valor_Real_Jugado AS NUMERIC), 2) AS VALOR_REAL_JUGADO,
  ROUND(SAFE_CAST(Valor_Real_Ganado AS NUMERIC), 2) AS VALOR_REAL_GANADO,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_MODIFICACIONES_SISTEMA_WIGOS_PROVEEDOR_RAW`