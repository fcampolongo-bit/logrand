config {
  type: "table",
  database: databases.stage,
  schema: "STG_GESTION_CLIENTES",
  name: "TBL_CARTERAS_MAQUINAS_STG",
  bigquery: {
    clusterBy: ["NUM_CLIENTE", "YEAR"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Year AS INT64) AS YEAR,
  SAFE_CAST(Mes AS INT64) AS MES,
  SAFE_CAST(Sala AS STRING) AS SALA,
  SAFE_CAST(Num_cliente AS INT64) AS NUM_CLIENTE,
  SAFE_CAST(Executive_Host AS STRING) AS EXECUTIVE_HOST,
  SAFE_CAST(Meta_WT AS NUMERIC) AS META_WT,
  SAFE_CAST(Bandera AS INT64) AS BANDERA,
  SAFE_CAST(Main AS INT64) AS MAIN,
  SAFE_CAST(Nivel_TO AS STRING) AS NIVEL_TO,
  SAFE_CAST(Jefe_Implementacion AS FLOAT64) AS JEFE_IMPLEMENTACION,
  SAFE_CAST(Meta_Visitas AS NUMERIC) AS META_VISITAS,
  SAFE_CAST(Tipo_Cartera AS STRING) AS TIPO_CARTERA,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_CARTERAS_MAQUINAS_RAW`