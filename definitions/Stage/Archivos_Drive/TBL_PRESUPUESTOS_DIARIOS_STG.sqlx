config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_PRESUPUESTOS_DIARIOS_STG",
  bigquery: {
    clusterBy: ["FECHA", "SALA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  COALESCE(
    SAFE_CAST(SUBSTR(CAST(Fecha AS STRING), 1, 10) AS DATE),
    SAFE.PARSE_DATE('%d/%m/%Y', CAST(Fecha AS STRING))
  ) AS FECHA,
  SAFE_CAST(Sala AS STRING) AS SALA,
  ROUND(SAFE_CAST(Coin_in_ppto AS NUMERIC), 4) AS COIN_IN_PPTO,
  ROUND(SAFE_CAST(Coin_in_red_ppto AS NUMERIC), 4) AS COIN_IN_RED_PPTO,
  ROUND(SAFE_CAST(Netwin_ppto AS NUMERIC), 4) AS NETWIN_PPTO,
  ROUND(SAFE_CAST(Netwin_red_ppto AS NUMERIC), 4) AS NETWIN_RED_PPTO,
  ROUND(SAFE_CAST(Drop_ppto AS NUMERIC), 4) AS DROP_PPTO,
  ROUND(SAFE_CAST(Win_mesas_ppto AS NUMERIC), 4) AS WIN_MESAS_PPTO,
  ROUND(SAFE_CAST(Entrada_maquinas_ppto AS NUMERIC), 4) AS ENTRADA_MAQUINAS_PPTO,
  ROUND(SAFE_CAST(Entrada_mesas_ppto AS NUMERIC), 4) AS ENTRADA_MESAS_PPTO,
  ROUND(SAFE_CAST(Resultado_maquinas_ppto AS NUMERIC), 4) AS RESULTADO_MAQUINAS_PPTO,
  ROUND(SAFE_CAST(Resultado_mesas_ppto AS NUMERIC), 4) AS RESULTADO_MESAS_PPTO,
  ROUND(SAFE_CAST(Ayb_ppto AS NUMERIC), 4) AS AYB_PPTO,
  ROUND(SAFE_CAST(Tfp_ayb_ppto AS NUMERIC), 4) AS TFP_AYB_PPTO,
  ROUND(SAFE_CAST(GGR_OTC_ppto AS NUMERIC), 4) AS GGR_OTC_PPTO,
  ROUND(SAFE_CAST(GGR_Plataforma_Afiliados_ppto AS NUMERIC), 4) AS GGR_PLATAFORMA_AFILIADOS_PPTO,
  ROUND(SAFE_CAST(GGR_Plataforma_Campanas_ppto AS NUMERIC), 2) AS GGR_PLATAFORMA_CAMPANAS_PPTO,
  ROUND(SAFE_CAST(GGR_Plataforma_Salas_ppto AS NUMERIC), 2) AS GGR_PLATAFORMA_SALAS_PPTO,
  ROUND(SAFE_CAST(GGR_Casino_Afiliados_ppto AS NUMERIC), 2) AS GGR_CASINO_AFILIADOS_PPTO,
  ROUND(SAFE_CAST(GGR_Casino_Campanas_ppto AS NUMERIC), 2) AS GGR_CASINO_CAMPANAS_PPTO,
  ROUND(SAFE_CAST(GGR_Casino_Salas_ppto AS NUMERIC), 2) AS GGR_CASINO_SALAS_PPTO,
  ROUND(SAFE_CAST(Depositos_Tarjetas_ppto AS NUMERIC), 2) AS DEPOSITOS_TARJETAS_PPTO,
  ROUND(SAFE_CAST(Depositos_Tiendas_ppto AS NUMERIC), 2) AS DEPOSITOS_TIENDAS_PPTO,
  ROUND(SAFE_CAST(Depositos_SPEI_ppto AS NUMERIC), 2) AS DEPOSITOS_SPEI_PPTO,
  ROUND(SAFE_CAST(Retiros_ppto AS NUMERIC), 2) AS RETIROS_PPTO,
  ROUND(SAFE_CAST(Conversion_Bonos_ppto AS NUMERIC), 2) AS CONVERSION_BONOS_PPTO,
  ROUND(SAFE_CAST(Charge_back_ppto AS NUMERIC), 2) AS CHARGE_BACK_PPTO,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_PRESUPUESTOS_DIARIOS_RAW`