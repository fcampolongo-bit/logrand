config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_CASINO_REPORT_STG",
  bigquery: {
    clusterBy: ["GAME_PROVIDER", "USERNAME"]
  },
  tags: ["carga_full_diaria_stg_archivos"]
}

SELECT
  SAFE_CAST(Game_Code AS STRING) AS GAME_CODE,
  SAFE_CAST(Platform AS STRING) AS PLATFORM,
  SAFE_CAST(Username AS STRING) AS USERNAME,
  SAFE_CAST(Game_Name AS STRING) AS GAME_NAME,
  SAFE_CAST(Game_Provider AS STRING) AS GAME_PROVIDER,
  SAFE_CAST(Game_Type AS STRING) AS GAME_TYPE,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Bet_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS BET_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Win_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS WIN_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(RM_Refund, r'[^0-9.\-]', '') AS NUMERIC), 4) AS RM_REFUND,
  ROUND(SAFE_CAST(REGEXP_REPLACE(GGR, r'[^0-9.\-]', '') AS NUMERIC), 4) AS GGR,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Bet_Bonus_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS BET_BONUS_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Win_Bonus_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS WIN_BONUS_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Bonus_Refund, r'[^0-9.\-]', '') AS NUMERIC), 4) AS BONUS_REFUND,
  ROUND(SAFE_CAST(REGEXP_REPLACE(GGR_Bonus, r'[^0-9.\-]', '') AS NUMERIC), 4) AS GGR_BONUS,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Game_Fee_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS GAME_FEE_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Payout, r'[^0-9.\-]', '') AS NUMERIC), 4) AS PAYOUT_PCT,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_CASINO_REPORT_RAW`