config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_GRAND_GDL_STG",
  bigquery: {
    clusterBy: ["FECHA", "CASINO"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Fecha AS DATE) AS FECHA,
  SAFE_CAST(Casino AS STRING) AS CASINO,
  SAFE_CAST(Inspector AS STRING) AS INSPECTOR,
  SAFE_CAST(Juego AS STRING) AS JUEGO,
  SAFE_CAST(Mesa AS STRING) AS MESA,
  SAFE_CAST(Incidencia AS STRING) AS INCIDENCIA,
  SAFE_CAST(Tipo_de_Incidencia AS STRING) AS TIPO_DE_INCIDENCIA,
  SAFE_CAST(Nivel_de_Riesgo AS STRING) AS NIVEL_DE_RIESGO,
  SAFE_CAST(Dealer AS STRING) AS DEALER,
  SAFE_CAST(Jefe_inmediato AS STRING) AS JEFE_INMEDIATO,
  SAFE_CAST(Gerente_en_turno AS STRING) AS GERENTE_EN_TURNO,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Tiempos_de_Verificacion, r'[^0-9.\-]', '') AS NUMERIC), 2) AS TIEMPOS_DE_VERIFICACION,
  SAFE_CAST(Deteccion AS STRING) AS DETECCION,
  SAFE_CAST(Proceso AS STRING) AS PROCESO,
  ROUND(SAFE_CAST(Encontra AS NUMERIC), 2) AS ENCONTRA,
  ROUND(SAFE_CAST(Recuperado AS NUMERIC), 2) AS RECUPERADO,
  ROUND(SAFE_CAST(A_Favor AS NUMERIC), 2) AS A_FAVOR,
  ROUND(SAFE_CAST(Pagado AS NUMERIC), 2) AS PAGADO,
  SAFE_CAST(ROUND(SAFE_CAST(Num_clientes AS NUMERIC)) AS INT64) AS NUM_CLIENTES,
  SAFE_CAST(ROUND(SAFE_CAST(Frecuencia AS NUMERIC)) AS INT64) AS FRECUENCIA,
  ROUND(SAFE_CAST(Tiempo AS NUMERIC), 2) AS TIEMPO,
  SAFE_CAST(PACER AS STRING) AS PACER,
  ROUND(SAFE_CAST(Puntos AS NUMERIC), 2) AS PUNTOS,
  SAFE_CAST(CTW AS STRING) AS CTW,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_BASE_RIESGOS_INCIDENCIAS_MESAS_GRAND_GDL_RAW`