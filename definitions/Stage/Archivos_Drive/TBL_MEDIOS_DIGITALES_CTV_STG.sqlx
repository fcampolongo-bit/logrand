config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_MEDIOS_DIGITALES_CTV_STG",
  bigquery: {
    clusterBy: ["YEAR", "MONTH"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Year AS STRING) AS YEAR,
  SAFE_CAST(Month AS STRING) AS MONTH,
  SAFE_CAST(Sala AS STRING) AS SALA,
  ROUND(SAFE_CAST(Inversion_CTV AS NUMERIC), 2) AS INVERSION_CTV,
  SAFE_CAST(ROUND(SAFE_CAST(Impresiones_CTV AS NUMERIC)) AS INT64) AS IMPRESIONES_CTV,
  SAFE_CAST(ROUND(SAFE_CAST(Alcance_CTV AS NUMERIC)) AS INT64) AS ALCANCE_CTV,
  SAFE_CAST(ROUND(SAFE_CAST(Clics_CTV AS NUMERIC)) AS INT64) AS CLICS_CTV,
  ROUND(SAFE_CAST(Encuesta_vio_ctv AS NUMERIC), 2) AS ENCUESTA_VIO_CTV,
  SAFE_CAST(Encuesta_influencia_CTV AS STRING) AS ENCUESTA_INFLUENCIA_CTV,
  ROUND(SAFE_CAST(CTV_Presupuesto_Asig_ AS NUMERIC), 2) AS CTV_PRESUPUESTO_ASIG,
  ROUND(SAFE_CAST(CTV_Ppto_Devengado AS NUMERIC), 2) AS CTV_PPTO_DEVENGADO,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_MEDIOS_DIGITALES_CTV_RAW`