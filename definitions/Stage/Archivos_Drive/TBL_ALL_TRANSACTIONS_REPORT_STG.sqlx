config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_ALL_TRANSACTIONS_REPORT_STG",
  bigquery: {
    clusterBy: ["TRANSACTION_TYPE", "USER_NAME"]
  },
  tags: ["carga_full_diaria_stg_archivos"]
}

SELECT
  SAFE_CAST(Transaction_ID AS INT64) AS TRANSACTION_ID,
  SAFE_CAST(Provider_Transaction_ID AS STRING) AS PROVIDER_TRANSACTION_ID,
  SAFE_CAST(Original_Transaction_ID AS INT64) AS ORIGINAL_TRANSACTION_ID,
  SAFE_CAST(User_Name AS STRING) AS USER_NAME,
  SAFE_CAST(First_Name AS STRING) AS FIRST_NAME,
  SAFE_CAST(Last_Name AS STRING) AS LAST_NAME,
  SAFE_CAST(Test_User AS BOOL) AS TEST_USER,
  SAFE_CAST(Country AS STRING) AS COUNTRY,
  SAFE_CAST(Currency AS STRING) AS CURRENCY,
  SAFE_CAST(Payment_Gateway AS STRING) AS PAYMENT_GATEWAY,
  SAFE_CAST(Payment_Method AS STRING) AS PAYMENT_METHOD,
  SAFE_CAST(Transaction_Type AS STRING) AS TRANSACTION_TYPE,
  SAFE_CAST(Status AS STRING) AS STATUS,
  SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M:%S', Date) AS FECHA,
  SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M:%S', Modified_On) AS MODIFIED_ON,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Original_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS ORIGINAL_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Original_Fee_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS ORIGINAL_FEE_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Fee_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS FEE_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Original_Game_Fee_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS ORIGINAL_GAME_FEE_AMOUNT,
  ROUND(SAFE_CAST(REGEXP_REPLACE(Game_Fee_Amount, r'[^0-9.\-]', '') AS NUMERIC), 4) AS GAME_FEE_AMOUNT,
  SAFE_CAST(Comment AS STRING) AS COMMENT,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_ALL_TRANSACTIONS_REPORT_RAW`