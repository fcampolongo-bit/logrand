config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_DROP_RIESGOS_MESAS_TOTAL_JUBILEE_GRAND_STG",
  bigquery: {
    clusterBy: ["FECHA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(FECHA AS DATE) AS FECHA,
  SAFE_CAST(DIA AS STRING) AS DIA,
  ROUND(SAFE_CAST(BLACK_JACK_1 AS NUMERIC), 2) AS BLACK_JACK_1,
  ROUND(SAFE_CAST(BLACK_JACK_2 AS NUMERIC), 2) AS BLACK_JACK_2,
  ROUND(SAFE_CAST(BLACK_JACK_3 AS NUMERIC), 2) AS BLACK_JACK_3,
  ROUND(SAFE_CAST(BLACK_JACK_4 AS NUMERIC), 2) AS BLACK_JACK_4,
  ROUND(SAFE_CAST(RULETA_1 AS NUMERIC), 2) AS RULETA_1,
  ROUND(SAFE_CAST(RULETA_2 AS NUMERIC), 2) AS RULETA_2,
  ROUND(SAFE_CAST(RULETA_3 AS NUMERIC), 2) AS RULETA_3,
  ROUND(SAFE_CAST(RULETA_4 AS NUMERIC), 2) AS RULETA_4,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_1 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_1,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_2 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_2,
  ROUND(SAFE_CAST(CRAZY_4_POKER_1 AS NUMERIC), 2) AS CRAZY_4_POKER_1,
  ROUND(SAFE_CAST(THREE_CARD_POKER_1 AS NUMERIC), 2) AS THREE_CARD_POKER_1,
  ROUND(SAFE_CAST(MIDI_BACCARAT_1 AS NUMERIC), 2) AS MIDI_BACCARAT_1,
  ROUND(SAFE_CAST(MIDI_BACCARAT_2 AS NUMERIC), 2) AS MIDI_BACCARAT_2,
  ROUND(SAFE_CAST(MIDI_BACCARAT_3 AS NUMERIC), 2) AS MIDI_BACCARAT_3,
  ROUND(SAFE_CAST(MIDI_BACCARAT_4 AS NUMERIC), 2) AS MIDI_BACCARAT_4,
  ROUND(SAFE_CAST(MIDI_BACCARAT_5 AS NUMERIC), 2) AS MIDI_BACCARAT_5,
  ROUND(SAFE_CAST(MIDI_BACCARAT_6 AS NUMERIC), 2) AS MIDI_BACCARAT_6,
  ROUND(SAFE_CAST(MIDI_BACCARAT_7 AS NUMERIC), 2) AS MIDI_BACCARAT_7,
  ROUND(SAFE_CAST(MIDI_BACCARAT_8 AS NUMERIC), 2) AS MIDI_BACCARAT_8,
  ROUND(SAFE_CAST(MIDI_BACCARAT_9 AS NUMERIC), 2) AS MIDI_BACCARAT_9,
  ROUND(SAFE_CAST(MIDI_BACCARAT_10 AS NUMERIC), 2) AS MIDI_BACCARAT_10,
  ROUND(SAFE_CAST(MIDI_BACCARAT_11 AS NUMERIC), 2) AS MIDI_BACCARAT_11,
  ROUND(SAFE_CAST(MIDI_BACCARAT_VIP_4 AS NUMERIC), 2) AS MIDI_BACCARAT_VIP_4,
  ROUND(SAFE_CAST(MIDI_BACCARAT_12 AS NUMERIC), 2) AS MIDI_BACCARAT_12,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_5 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_5,
  ROUND(SAFE_CAST(MIDI_BACCARAT_13 AS NUMERIC), 2) AS MIDI_BACCARAT_13,
  ROUND(SAFE_CAST(XTREME_ROULETTE_1 AS NUMERIC), 2) AS XTREME_ROULETTE_1,
  ROUND(SAFE_CAST(XTREME_ROULETTE_2 AS NUMERIC), 2) AS XTREME_ROULETTE_2,
  ROUND(SAFE_CAST(CRAZY_4_POKER_3 AS NUMERIC), 2) AS CRAZY_4_POKER_3,
  ROUND(SAFE_CAST(MIDI_BACCARAT_14 AS NUMERIC), 2) AS MIDI_BACCARAT_14,
  ROUND(SAFE_CAST(MIDI_BACCARAT_15 AS NUMERIC), 2) AS MIDI_BACCARAT_15,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_DROP_RIESGOS_MESAS_TOTAL_JUBILEE_GRAND_RAW`