config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_DESCRIPTIVOS_INVENTARIO_STG",
  bigquery: {
    clusterBy: ["YEAR", "SALA"]
  },
  tags: ["carga_full_semanal_stg_archivos"]
}

SELECT
  SAFE_CAST(Year AS INT64) AS YEAR,
  SAFE_CAST(Week AS INT64) AS WEEK,
  SAFE_CAST(Sala AS STRING) AS SALA,
  SAFE_CAST(NE AS INT64) AS NE,
  SAFE_CAST(Game_Type AS STRING) AS GAME_TYPE,
  SAFE_CAST(Zone AS STRING) AS ZONE,
  SAFE_CAST(Type_Island AS STRING) AS TYPE_ISLAND,
  SAFE_CAST(Type_Location AS STRING) AS TYPE_LOCATION,
  SAFE_CAST(Provider AS STRING) AS PROVIDER,
  SAFE_CAST(Cabinet AS STRING) AS CABINET,
  SAFE_CAST(Game AS STRING) AS GAME,
  SAFE_CAST(Bonos___Features AS STRING) AS BONOS_FEATURES,
  SAFE_CAST(Volatilidad AS STRING) AS VOLATILIDAD,
  ROUND(SAFE_CAST(TOP_AWARD AS NUMERIC), 2) AS TOP_AWARD,
  SAFE_CAST(Linked AS STRING) AS LINKED,
  SAFE_CAST(Type_Progressive AS STRING) AS TYPE_PROGRESSIVE,
  ROUND(SAFE_CAST(RTP_Total AS NUMERIC), 3) AS RTP_TOTAL,
  ROUND(SAFE_CAST(RTP_Game_Base AS NUMERIC), 3) AS RTP_GAME_BASE,
  ROUND(SAFE_CAST(RTP_Game_Base_Single AS NUMERIC), 3) AS RTP_GAME_BASE_SINGLE,
  ROUND(SAFE_CAST(RTP_Game_Base_Min AS NUMERIC), 3) AS RTP_GAME_BASE_MIN,
  ROUND(SAFE_CAST(RTP_Game_Base_Max AS NUMERIC), 3) AS RTP_GAME_BASE_MAX,
  ROUND(SAFE_CAST(_Total_Contribution AS NUMERIC), 2) AS TOTAL_CONTRIBUTION,
  ROUND(SAFE_CAST(Contribution_1 AS NUMERIC), 2) AS CONTRIBUTION_1,
  ROUND(SAFE_CAST(Contribution_2 AS NUMERIC), 2) AS CONTRIBUTION_2,
  ROUND(SAFE_CAST(Contribution_3 AS NUMERIC), 2) AS CONTRIBUTION_3,
  ROUND(SAFE_CAST(Contribution_4 AS NUMERIC), 2) AS CONTRIBUTION_4,
  ROUND(SAFE_CAST(Den AS NUMERIC), 2) AS DEN,
  ROUND(SAFE_CAST(Min_Bet AS NUMERIC), 2) AS MIN_BET,
  ROUND(SAFE_CAST(Max_Bet AS NUMERIC), 2) AS MAX_BET,
  ROUND(SAFE_CAST(Max_Multiplier AS NUMERIC), 2) AS MAX_MULTIPLIER,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_DESCRIPTIVOS_INVENTARIO_RAW`