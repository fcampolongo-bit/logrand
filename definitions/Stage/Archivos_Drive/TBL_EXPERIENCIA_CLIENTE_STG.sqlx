config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_EXPERIENCIA_CLIENTE_STG",
  bigquery: {
    clusterBy: ["YEAR", "SALA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Metrica AS STRING) AS METRICA,
  SAFE_CAST(Sala AS STRING) AS SALA,
  SAFE_CAST(Term AS STRING) AS TERM,
  SAFE_CAST(Year AS INT64) AS YEAR,
  ROUND(SAFE_CAST(Value AS NUMERIC), 4) AS VALUE,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_EXPERIENCIA_CLIENTE_RAW`