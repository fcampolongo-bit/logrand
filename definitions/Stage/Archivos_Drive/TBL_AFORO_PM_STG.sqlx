config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_AFORO_PM_STG",
  bigquery: {
    clusterBy: ["ENTIDAD", "ANO"]
  },
  tags: ["carga_full_mensual_stg_archivos"],
 assertions: {
    uniqueKey: ["GRUPO", "ENTIDAD", "LDN", "REGION", "CATEGORIA", "ANO", "MES"]
  }
}

SELECT
  SAFE_CAST(Grupo AS STRING) AS GRUPO,
  SAFE_CAST(Entidad AS STRING) AS ENTIDAD,
  SAFE_CAST(LDN AS STRING) AS LDN,
  SAFE_CAST(Region AS STRING) AS REGION,
  SAFE_CAST(Categoria AS STRING) AS CATEGORIA,
  SAFE_CAST(Ano AS INT64) AS ANO,
  SAFE_CAST(Mes AS INT64) AS MES,
  ROUND(SAFE_CAST(Ocupacion_Entidad AS NUMERIC), 2) AS OCUPACION_ENTIDAD,
  SAFE_CAST(Ocupacion_Total AS INT64) AS OCUPACION_TOTAL,
  ROUND(SAFE_CAST(PM_Mensual AS NUMERIC), 4) AS PM_MENSUAL,
  ROUND(SAFE_CAST(PM_Ultimos_3M AS NUMERIC), 4) AS PM_ULTIMOS_3M,
  ROUND(SAFE_CAST(PM_Ultimos_6M AS NUMERIC), 4) AS PM_ULTIMOS_6M,
  ROUND(SAFE_CAST(PM_Ultimos_12M AS NUMERIC), 4) AS PM_ULTIMOS_12M,
  ROUND(SAFE_CAST(Var_Mes_vs_Ano_Ant AS NUMERIC), 4) AS VAR_MES_VS_ANO_ANT,
  ROUND(SAFE_CAST(Var_3M_vs_Ano_Ant AS NUMERIC), 4) AS VAR_3M_VS_ANO_ANT,
  ROUND(SAFE_CAST(Var_6M_vs_Ano_Ant AS NUMERIC), 4) AS VAR_6M_VS_ANO_ANT,
  ROUND(SAFE_CAST(Var_12M_vs_Ano_Ant AS NUMERIC), 2) AS VAR_12M_VS_ANO_ANT,
  ROUND(SAFE_CAST(Crec_3M_vs_Ano_Ant AS NUMERIC), 2) AS CREC_3M_VS_ANO_ANT,
  ROUND(SAFE_CAST(Crec_6M_vs_Ano_Ant AS NUMERIC), 2) AS CREC_6M_VS_ANO_ANT,
  ROUND(SAFE_CAST(Crec_12M_vs_Ano_Ant AS NUMERIC), 2) AS CREC_12M_VS_ANO_ANT,
  SAFE_CAST(Ciudad AS STRING) AS CIUDAD,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_AFORO_PM_RAW`