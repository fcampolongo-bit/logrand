config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_REGISTRATION_REPORT_STG",
  bigquery: {
    clusterBy: ["PLAYER_ID"]
  },
  tags: ["carga_full_diaria_stg_archivos"]
}

SELECT
  SAFE_CAST(Player_ID AS INT64) AS PLAYER_ID,
  SAFE_CAST(Username AS STRING) AS USERNAME,
  SAFE_CAST(First_Name AS STRING) AS FIRST_NAME,
  SAFE_CAST(LastName AS STRING) AS LAST_NAME,
  SAFE_CAST(Email AS STRING) AS EMAIL,
  DATE(SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M:%S', Date_Of_Birth)) AS DATE_OF_BIRTH,
  SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M:%S', Registration_Date) AS REGISTRATION_DATE,
  SAFE_CAST(Marketing_Code AS STRING) AS MARKETING_CODE,
  SAFE_CAST(Gender AS STRING) AS GENDER,
  SAFE_CAST(City AS STRING) AS CITY,
  SAFE_CAST(Country AS STRING) AS COUNTRY,
  IF(Phone IS NULL, NULL, FORMAT('%.0f', Phone)) AS PHONE,
  IF(MobilePhone IS NULL, NULL, FORMAT('%.0f', MobilePhone)) AS MOBILE_PHONE,
  SAFE_CAST(IP_Address AS STRING) AS IP_ADDRESS,
  SAFE_CAST(Login_Count AS INT64) AS LOGIN_COUNT,
  SAFE_CAST(BTag AS STRING) AS BTAG,
  SAFE_CAST(Civil_Identification_Code AS STRING) AS CIVIL_IDENTIFICATION_CODE,
  SAFE.PARSE_DATE('%d/%m/%Y', KYC_Issue_On) AS KYC_ISSUE_ON,
  SAFE_CAST(Is_Cancelled AS BOOL) AS IS_CANCELLED,
  SAFE_CAST(Device_Type AS STRING) AS DEVICE_TYPE,
  SAFE_CAST(Referral_Source AS STRING) AS REFERRAL_SOURCE,
  SAFE_CAST(State AS STRING) AS STATE,
  SAFE_CAST(Zip_Code AS STRING) AS ZIP_CODE,
  SAFE_CAST(UtmSource AS STRING) AS UTM_SOURCE,
  SAFE_CAST(UtmMedium AS STRING) AS UTM_MEDIUM,
  SAFE_CAST(UtmCampaign AS STRING) AS UTM_CAMPAIGN,
  SAFE_CAST(UtmTerm AS STRING) AS UTM_TERM,
  SAFE_CAST(UtmContent AS STRING) AS UTM_CONTENT,
  SAFE_CAST(Par AS STRING) AS PAR,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_REGISTRATION_REPORT_RAW`