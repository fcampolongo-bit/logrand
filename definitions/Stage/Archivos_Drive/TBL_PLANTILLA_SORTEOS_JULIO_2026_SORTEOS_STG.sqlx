config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_PLANTILLA_SORTEOS_JULIO_2026_SORTEOS_STG",
  bigquery: {
    clusterBy: ["ANO", "MES_DEL_SORTEO"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Empresa AS STRING) AS EMPRESA,
  SAFE_CAST(LDN AS STRING) AS LDN,
  SAFE_CAST(Ano AS INT64) AS ANO,
  SAFE_CAST(Mes_del_Sorteo AS STRING) AS MES_DEL_SORTEO,
  SAFE_CAST(__Mes AS INT64) AS MES,
  SAFE_CAST(UDN AS STRING) AS UDN,
  SAFE_CAST(Nivel_Logrand AS STRING) AS NIVEL_LOGRAND,
  SAFE_CAST(_Nivel_Logrand AS INT64) AS NIVEL_LOGRAND_NUM,
  SAFE_CAST(Nombre_del_Sorteo AS STRING) AS NOMBRE_DEL_SORTEO,
  SAFE_CAST(Etiqueta_de_Folio AS STRING) AS ETIQUETA_DE_FOLIO,
  SAFE_CAST(Niveles_Participantes AS STRING) AS NIVELES_PARTICIPANTES,
  DATE(Fecha_Inicial__Periodo_de_Canje_) AS FECHA_INICIAL_PERIODO_DE_CANJE,
  DATE(Fecha_Final__Periodo_de_Canje_) AS FECHA_FINAL_PERIODO_DE_CANJE,
  SAFE_CAST(__Dias_de_Canje AS INT64) AS DIAS_DE_CANJE,
  SAFE_CAST(__Fechas_del_Sorteo AS INT64) AS FECHAS_DEL_SORTEO,
  SAFE_CAST(Costo_del_Folio AS INT64) AS COSTO_DEL_FOLIO,
  SAFE_CAST(Clientes_con_folio AS INT64) AS CLIENTES_CON_FOLIO,
  SAFE_CAST(Folios_Canjeados AS INT64) AS FOLIOS_CANJEADOS,
  SAFE_CAST(Base_Activa__Periodo_de_Canje_ AS INT64) AS BASE_ACTIVA_PERIODO_DE_CANJE,
  ROUND(SAFE_CAST(Participacion__Periodo_de_Canje_ AS NUMERIC), 4) AS PARTICIPACION_PERIODO_DE_CANJE,
  SAFE_CAST(ActivosC_Folio__Fecha_1 AS INT64) AS ACTIVOSC_FOLIO_FECHA_1,
  SAFE_CAST(ROUND(SAFE_CAST(ActivosC_Folio__Fecha_2 AS NUMERIC)) AS INT64) AS ACTIVOSC_FOLIO_FECHA_2,
  SAFE_CAST(ROUND(SAFE_CAST(ActivosC_Folio__Fecha_3 AS NUMERIC)) AS INT64) AS ACTIVOSC_FOLIO_FECHA_3,
  SAFE_CAST(ROUND(SAFE_CAST(ActivosC_Folio__Fecha_4 AS NUMERIC)) AS INT64) AS ACTIVOSC_FOLIO_FECHA_4,
  SAFE_CAST(Base_Activos_Fecha_1 AS INT64) AS BASE_ACTIVOS_FECHA_1,
  SAFE_CAST(ROUND(SAFE_CAST(Base_Activos_Fecha_2 AS NUMERIC)) AS INT64) AS BASE_ACTIVOS_FECHA_2,
  SAFE_CAST(ROUND(SAFE_CAST(Base_Activos_Fecha_3 AS NUMERIC)) AS INT64) AS BASE_ACTIVOS_FECHA_3,
  SAFE_CAST(ROUND(SAFE_CAST(Base_Activos_Fecha_4 AS NUMERIC)) AS INT64) AS BASE_ACTIVOS_FECHA_4,
  ROUND(SAFE_CAST(Participacion_en_Evento AS NUMERIC), 4) AS PARTICIPACION_EN_EVENTO,
  ROUND(SAFE_CAST(Participacion_Fecha_1 AS NUMERIC), 4) AS PARTICIPACION_FECHA_1,
  ROUND(SAFE_CAST(Participacion_Fecha_2 AS NUMERIC), 4) AS PARTICIPACION_FECHA_2,
  ROUND(SAFE_CAST(Participacion_Fecha_3 AS NUMERIC), 4) AS PARTICIPACION_FECHA_3,
  ROUND(SAFE_CAST(Participacion_Fecha_4 AS NUMERIC), 4) AS PARTICIPACION_FECHA_4,
  SAFE_CAST(Etiqueta_pago_1 AS STRING) AS ETIQUETA_PAGO_1,
  SAFE_CAST(Etiqueta_pago_2 AS STRING) AS ETIQUETA_PAGO_2,
  SAFE_CAST(Etiqueta_pago_3 AS STRING) AS ETIQUETA_PAGO_3,
  SAFE_CAST(Etiqueta_pago_4 AS STRING) AS ETIQUETA_PAGO_4,
  SAFE_CAST(__Pago_Sorteo AS INT64) AS PAGO_SORTEO,
  SAFE_CAST(Etiqueta_Adicional AS STRING) AS ETIQUETA_ADICIONAL,
  SAFE_CAST(__Pago_Adicional AS INT64) AS PAGO_ADICIONAL,
  SAFE_CAST(__Total_Pago_Sorteo AS INT64) AS TOTAL_PAGO_SORTEO,
  SAFE_CAST(__Entregas AS INT64) AS ENTREGAS,
  SAFE_CAST(__Ganadores__Unicos_ AS INT64) AS GANADORES_UNICOS,
  DATE(Fecha_1) AS FECHA_1,
  DATE(Fecha_2) AS FECHA_2,
  DATE(Fecha_3) AS FECHA_3,
  DATE_ADD(DATE '1899-12-30', INTERVAL SAFE_CAST(Fecha_4 AS INT64) DAY) AS FECHA_4,
  ROUND(SAFE_CAST(Win_Teo_Red__Periodo_de_Canje_ AS NUMERIC), 4) AS WIN_TEO_RED_PERIODO_DE_CANJE,
  DATE(Fecha_Inicial__Periodo_Previo_) AS FECHA_INICIAL_PERIODO_PREVIO,
  DATE(Fecha_Final__Periodo_Previo_) AS FECHA_FINAL_PERIODO_PREVIO,
  SAFE_CAST(Base_Activa__Periodo_Previo_ AS INT64) AS BASE_ACTIVA_PERIODO_PREVIO,
  ROUND(SAFE_CAST(Win_Teo_Red__Periodo_Previo_ AS NUMERIC), 4) AS WIN_TEO_RED_PERIODO_PREVIO,
  ROUND(SAFE_CAST(Delta_Win_TR AS NUMERIC), 4) AS DELTA_WIN_TR,
  ROUND(SAFE_CAST(Costo_Sorteo AS NUMERIC), 4) AS COSTO_SORTEO,
  ROUND(SAFE_CAST(ROI_Delta AS NUMERIC), 4) AS ROI_DELTA,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_PLANTILLA_SORTEOS_JULIO_2026_SORTEOS_RAW`