config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_BASE_DATOS_DIARIA_CASINOS_NETWIN_NO_CONCILIADO_STG",
  bigquery: {
    clusterBy: ["FACTURACION"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Facturacion AS DATE) AS FACTURACION,
  ROUND(SAFE_CAST(Jubilee AS NUMERIC), 2) AS JUBILEE,
  ROUND(SAFE_CAST(New_York AS NUMERIC), 2) AS NEW_YORK,
  ROUND(SAFE_CAST(Paradise AS NUMERIC), 2) AS PARADISE,
  ROUND(SAFE_CAST(San_Marcos AS NUMERIC), 2) AS SAN_MARCOS,
  ROUND(SAFE_CAST(Golden_Island AS NUMERIC), 2) AS GOLDEN_ISLAND,
  ROUND(SAFE_CAST(Paradise_Island AS NUMERIC), 2) AS PARADISE_ISLAND,
  ROUND(SAFE_CAST(Dubai_Palace AS NUMERIC), 2) AS DUBAI_PALACE,
  ROUND(SAFE_CAST(Viva_Mexico AS NUMERIC), 2) AS VIVA_MEXICO,
  ROUND(SAFE_CAST(Taj_Mahal AS NUMERIC), 2) AS TAJ_MAHAL,
  ROUND(SAFE_CAST(Providens AS NUMERIC), 2) AS PROVIDENS,
  ROUND(SAFE_CAST(El_Dorado AS NUMERIC), 2) AS EL_DORADO,
  ROUND(SAFE_CAST(Grand__Gdl_ AS NUMERIC), 2) AS GRAND_GDL,
  ROUND(SAFE_CAST(Grand__Leon_ AS NUMERIC), 2) AS GRAND_LEON,
  ROUND(SAFE_CAST(Hollywood__E_ AS NUMERIC), 2) AS HOLLYWOOD_E,
  ROUND(SAFE_CAST(Hollywood__C_ AS NUMERIC), 2) AS HOLLYWOOD_C,
  ROUND(SAFE_CAST(Vivento_Apodaca AS NUMERIC), 2) AS VIVENTO_APODACA,
  ROUND(SAFE_CAST(Vivento_4_Rios AS NUMERIC), 2) AS VIVENTO_4_RIOS,
  ROUND(SAFE_CAST(Jubilee_Grand_Casino AS NUMERIC), 2) AS JUBILEE_GRAND_CASINO,
  ROUND(SAFE_CAST(Total AS NUMERIC), 2) AS TOTAL,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_BASE_DATOS_DIARIA_CASINOS_NETWIN_NO_CONCILIADO_RAW`