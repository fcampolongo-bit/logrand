config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_MODIFICACIONES_SISTEMA_WIGOS_DETALLE_ESTADISTICAS_STG",
  bigquery: {
    clusterBy: ["FECHA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Fecha AS DATE) AS FECHA,
  SAFE_CAST(Proveedor AS STRING) AS PROVEEDOR,
  ROUND(SAFE_CAST(El_Dorado AS NUMERIC), 2) AS EL_DORADO,
  ROUND(SAFE_CAST(Golden_Island AS NUMERIC), 2) AS GOLDEN_ISLAND,
  ROUND(SAFE_CAST(Grand_Leon AS NUMERIC), 2) AS GRAND_LEON,
  ROUND(SAFE_CAST(Hollywood_Constitucion AS NUMERIC), 2) AS HOLLYWOOD_CONSTITUCION,
  ROUND(SAFE_CAST(Hollywood_Valle_Alto AS NUMERIC), 2) AS HOLLYWOOD_VALLE_ALTO,
  ROUND(SAFE_CAST(Jubilee AS NUMERIC), 2) AS JUBILEE,
  SAFE_CAST(Jubilee_Cancun AS INT64) AS JUBILEE_CANCUN,
  SAFE_CAST(ROUND(SAFE_CAST(Jubilee_Grand_Casino AS NUMERIC)) AS INT64) AS JUBILEE_GRAND_CASINO,
  SAFE_CAST(New_York AS INT64) AS NEW_YORK,
  SAFE_CAST(Paradise AS INT64) AS PARADISE,
  SAFE_CAST(Paradise_Island AS INT64) AS PARADISE_ISLAND,
  SAFE_CAST(Providens AS INT64) AS PROVIDENS,
  SAFE_CAST(San_Marcos AS INT64) AS SAN_MARCOS,
  SAFE_CAST(Taj_Mahal AS INT64) AS TAJ_MAHAL,
  SAFE_CAST(Viva_Mexico AS INT64) AS VIVA_MEXICO,
  SAFE_CAST(ROUND(SAFE_CAST(Vivento_4_Rios AS NUMERIC)) AS INT64) AS VIVENTO_4_RIOS,
  SAFE_CAST(ROUND(SAFE_CAST(Vivento_Apodaca AS NUMERIC)) AS INT64) AS VIVENTO_APODACA,
  SAFE_CAST(Vivento_Zapopan AS INT64) AS VIVENTO_ZAPOPAN,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_MODIFICACIONES_SISTEMA_WIGOS_DETALLE_ESTADISTICAS_RAW`