config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_TABLERO_TM_CONSOLIDADO_STG",
  bigquery: {
    clusterBy: ["ANO", "SALA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Ano AS INT64) AS ANO,
  SAFE_CAST(Mes AS STRING) AS MES,
  SAFE_CAST(Sala AS STRING) AS SALA,
  ROUND(SAFE_CAST(Net_Win_Total__Slots_Mesas AS NUMERIC), 4) AS NET_WIN_TOTAL_SLOTS_MESAS,
  ROUND(SAFE_CAST(TM_sobre_NW__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_NW__CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_CC,
  ROUND(SAFE_CAST(Alcance_Ppto_Win AS NUMERIC), 4) AS ALCANCE_PPTO_WIN,
  ROUND(SAFE_CAST(Win_Teorico_Red_Total__Slots_Mesas AS NUMERIC), 4) AS WIN_TEORICO_RED_TOTAL_SLOTS_MESAS,
  ROUND(SAFE_CAST(Crecimiento_vs_AA_Slots___Mesas AS NUMERIC), 4) AS CRECIMIENTO_VS_AA_SLOTS_MESAS,
  ROUND(SAFE_CAST(Crecimiento_vs_MA_Slots___Mesas AS NUMERIC), 4) AS CRECIMIENTO_VS_MA_SLOTS_MESAS,
  ROUND(SAFE_CAST(TM_sobre_WTR__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_WTR_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_WTR__CC_ AS NUMERIC), 4) AS TM_SOBRE_WTR_CC,
  ROUND(SAFE_CAST(Clientes__Unicos__2024 AS NUMERIC), 4) AS CLIENTES_UNICOS_2024,
  ROUND(SAFE_CAST(Clientes_Nuevos_2024 AS NUMERIC), 4) AS CLIENTES_NUEVOS_2024,
  ROUND(SAFE_CAST(Clientes__Unicos__2023 AS NUMERIC), 4) AS CLIENTES_UNICOS_2023,
  ROUND(SAFE_CAST(Clientes_Nuevos_2023 AS NUMERIC), 4) AS CLIENTES_NUEVOS_2023,
  ROUND(SAFE_CAST(R_Cliente__Win_sobre_Costo_ AS NUMERIC), 4) AS R_CLIENTE_WIN_SOBRE_COSTO,
  ROUND(SAFE_CAST(Clientes_con_AC AS NUMERIC), 4) AS CLIENTES_CON_AC,
  ROUND(SAFE_CAST(Clientes_con_Costo___100_Win_sobre_Costo AS NUMERIC), 4) AS CLIENTES_CON_COSTO_100_WIN_SOBRE_COSTO,
  ROUND(SAFE_CAST(Costo_promedio_por_Persona_Win_sobre_Costo AS NUMERIC), 4) AS COSTO_PROMEDIO_POR_PERSONA_WIN_SOBRE_COSTO,
  ROUND(SAFE_CAST(ROI_Delta_Cliente__6_vs_6_Meses_Previos_ AS NUMERIC), 4) AS ROI_DELTA_CLIENTE_6_VS_6_MESES_PREVIOS,
  ROUND(SAFE_CAST(Clientes_con_Costo___100_6vs6_Meses_Previos AS NUMERIC), 4) AS CLIENTES_CON_COSTO_100_6VS6_MESES_PREVIOS,
  ROUND(SAFE_CAST(Costo_promedio_por_Persona_6vs6_Meses_Previos AS NUMERIC), 4) AS COSTO_PROMEDIO_POR_PERSONA_6VS6_MESES_PREVIOS,
  ROUND(SAFE_CAST(Delta_Win_por_Persona AS NUMERIC), 4) AS DELTA_WIN_POR_PERSONA,
  ROUND(SAFE_CAST(CC_FP__Costo_Slots___Mesas_ AS NUMERIC), 4) AS CC_FP_COSTO_SLOTS_MESAS,
  ROUND(SAFE_CAST(Free_Play AS NUMERIC), 4) AS FREE_PLAY,
  ROUND(SAFE_CAST(CR_Slots___Mesas AS NUMERIC), 4) AS CR_SLOTS_MESAS,
  ROUND(SAFE_CAST(CNR_Slots___Mesas AS NUMERIC), 4) AS CNR_SLOTS_MESAS,
  ROUND(SAFE_CAST(FNR_Slots___Mesas AS NUMERIC), 4) AS FNR_SLOTS_MESAS,
  ROUND(SAFE_CAST(Cuentas_Contables AS NUMERIC), 4) AS CUENTAS_CONTABLES,
  ROUND(SAFE_CAST(Activaciones_y_Eventos_Slots___Mesas AS NUMERIC), 4) AS ACTIVACIONES_Y_EVENTOS_SLOTS_MESAS,
  ROUND(SAFE_CAST(Obsequios_Promocionales_Slots___Mesas AS NUMERIC), 4) AS OBSEQUIOS_PROMOCIONALES_SLOTS_MESAS,
  ROUND(SAFE_CAST(Puntos_A_Slots___Mesas AS NUMERIC), 4) AS PUNTOS_A_SLOTS_MESAS,
  ROUND(SAFE_CAST(Costo_TV_sobre_Ingreso AS NUMERIC), 4) AS COSTO_TV_SOBRE_INGRESO,
  ROUND(SAFE_CAST(Uso_Ppto_TV AS NUMERIC), 4) AS USO_PPTO_TV,
  ROUND(SAFE_CAST(CC_FP__Uso_de_Ppto_MKT_ AS NUMERIC), 4) AS CC_FP_USO_DE_PPTO_MKT,
  ROUND(SAFE_CAST(CR_Ppto_MKT AS NUMERIC), 4) AS CR_PPTO_MKT,
  ROUND(SAFE_CAST(CNR_Ppto_MKT AS NUMERIC), 4) AS CNR_PPTO_MKT,
  ROUND(SAFE_CAST(FNR_Ppto_MKT AS NUMERIC), 4) AS FNR_PPTO_MKT,
  ROUND(SAFE_CAST(Activaciones_y_Eventos_Ppto_MKT AS NUMERIC), 4) AS ACTIVACIONES_Y_EVENTOS_PPTO_MKT,
  ROUND(SAFE_CAST(Obsequios_Promocionales_Ppto_MKT AS NUMERIC), 4) AS OBSEQUIOS_PROMOCIONALES_PPTO_MKT,
  ROUND(SAFE_CAST(Puntos_A_Ppto_MKT AS NUMERIC), 4) AS PUNTOS_A_PPTO_MKT,
  ROUND(SAFE_CAST(Net_Win_Slots AS NUMERIC), 4) AS NET_WIN_SLOTS,
  ROUND(SAFE_CAST(TM_sobre_NW_Slots__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_SLOTS_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_NW_Slots__CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_SLOTS_CC,
  ROUND(SAFE_CAST(Alcance_Ppto_Win__Slots_ AS NUMERIC), 4) AS ALCANCE_PPTO_WIN_SLOTS,
  ROUND(SAFE_CAST(Win_Teo_Red_Slots AS NUMERIC), 4) AS WIN_TEO_RED_SLOTS,
  ROUND(SAFE_CAST(Crecimiento_vs_AA_Slots AS NUMERIC), 4) AS CRECIMIENTO_VS_AA_SLOTS,
  ROUND(SAFE_CAST(Crecimiento_vs_MA_Slots AS NUMERIC), 4) AS CRECIMIENTO_VS_MA_SLOTS,
  ROUND(SAFE_CAST(TM_sobre_WT_Red_Slots__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_WT_RED_SLOTS_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_WT_Red_Slots__CC_ AS NUMERIC), 4) AS TM_SOBRE_WT_RED_SLOTS_CC,
  ROUND(SAFE_CAST(Clientes_Activos_Slots AS NUMERIC), 4) AS CLIENTES_ACTIVOS_SLOTS,
  ROUND(SAFE_CAST(Clientes_Activos_Cartera_Slots AS NUMERIC), 4) AS CLIENTES_ACTIVOS_CARTERA_SLOTS,
  ROUND(SAFE_CAST(Contribucion_WT_Cartera_a_LDN_Slots AS NUMERIC), 4) AS CONTRIBUCION_WT_CARTERA_A_LDN_SLOTS,
  ROUND(SAFE_CAST(CC_FP__Costo_Slots_ AS NUMERIC), 4) AS CC_FP_COSTO_SLOTS,
  ROUND(SAFE_CAST(CR_Slots AS NUMERIC), 4) AS CR_SLOTS,
  ROUND(SAFE_CAST(CR_Activaciones AS NUMERIC), 4) AS CR_ACTIVACIONES,
  ROUND(SAFE_CAST(CR_Beneficios_TOR AS NUMERIC), 4) AS CR_BENEFICIOS_TOR,
  ROUND(SAFE_CAST(CR_Canjes AS NUMERIC), 4) AS CR_CANJES,
  ROUND(SAFE_CAST(CR_Cash_Back_Slots AS NUMERIC), 4) AS CR_CASH_BACK_SLOTS,
  ROUND(SAFE_CAST(CR_Discrecional_Sala AS NUMERIC), 4) AS CR_DISCRECIONAL_SALA,
  ROUND(SAFE_CAST(CR_Hot_Seat AS NUMERIC), 4) AS CR_HOT_SEAT,
  ROUND(SAFE_CAST(CR_Pago_Folios AS NUMERIC), 4) AS CR_PAGO_FOLIOS,
  ROUND(SAFE_CAST(CR_Servicios AS NUMERIC), 4) AS CR_SERVICIOS,
  ROUND(SAFE_CAST(CR_Sorteos_Slots AS NUMERIC), 4) AS CR_SORTEOS_SLOTS,
  ROUND(SAFE_CAST(CR_Uso_Sala AS NUMERIC), 4) AS CR_USO_SALA,
  ROUND(SAFE_CAST(CNR_Slots AS NUMERIC), 4) AS CNR_SLOTS,
  ROUND(SAFE_CAST(CNR_Beneficios_TOR AS NUMERIC), 4) AS CNR_BENEFICIOS_TOR,
  ROUND(SAFE_CAST(CNR_Canjes AS NUMERIC), 4) AS CNR_CANJES,
  ROUND(SAFE_CAST(CNR_Cash_Back_Slots AS NUMERIC), 4) AS CNR_CASH_BACK_SLOTS,
  ROUND(SAFE_CAST(CNR_DDM AS NUMERIC), 4) AS CNR_DDM,
  ROUND(SAFE_CAST(CNR_Discrecional_EH_Slots AS NUMERIC), 4) AS CNR_DISCRECIONAL_EH_SLOTS,
  ROUND(SAFE_CAST(CNR_Discrecional_GDU AS NUMERIC), 4) AS CNR_DISCRECIONAL_GDU,
  ROUND(SAFE_CAST(CNR_Discrecional_Sala AS NUMERIC), 4) AS CNR_DISCRECIONAL_SALA,
  ROUND(SAFE_CAST(CNR_Encuestas AS NUMERIC), 4) AS CNR_ENCUESTAS,
  ROUND(SAFE_CAST(CNR_Promociones AS NUMERIC), 4) AS CNR_PROMOCIONES,
  ROUND(SAFE_CAST(CNR_Uso_Sala AS NUMERIC), 4) AS CNR_USO_SALA,
  ROUND(SAFE_CAST(Activaciones_y_Eventos_Slots AS NUMERIC), 4) AS ACTIVACIONES_Y_EVENTOS_SLOTS,
  ROUND(SAFE_CAST(Obsequios_Promocionales_Slots AS NUMERIC), 4) AS OBSEQUIOS_PROMOCIONALES_SLOTS,
  ROUND(SAFE_CAST(Obsequios AS NUMERIC), 4) AS OBSEQUIOS,
  ROUND(SAFE_CAST(Obsequios_Promocionales_Canjes AS NUMERIC), 4) AS OBSEQUIOS_PROMOCIONALES_CANJES,
  ROUND(SAFE_CAST(Puntos_A_Slots AS NUMERIC), 4) AS PUNTOS_A_SLOTS,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Discrecional_EH_EDC_Slots AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_DISCRECIONAL_EH_EDC_SLOTS,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Discrecional_GDU AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_DISCRECIONAL_GDU,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Discrecional_Sala AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_DISCRECIONAL_SALA,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_No_Discrecional AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_NO_DISCRECIONAL,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Sports_Book AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_SPORTS_BOOK,
  ROUND(SAFE_CAST(Puntos_A_Canjes AS NUMERIC), 4) AS PUNTOS_A_CANJES,
  ROUND(SAFE_CAST(Win_Mesas AS NUMERIC), 4) AS WIN_MESAS,
  ROUND(SAFE_CAST(TM_sobre_NW_Mesas__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_MESAS_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_NW_Mesas__CC_ AS NUMERIC), 4) AS TM_SOBRE_NW_MESAS_CC,
  ROUND(SAFE_CAST(Alcance_Ppto_Win__Mesas_ AS NUMERIC), 4) AS ALCANCE_PPTO_WIN_MESAS,
  ROUND(SAFE_CAST(WT_Mesas AS NUMERIC), 4) AS WT_MESAS,
  ROUND(SAFE_CAST(Crecimiento_vs_AA_Mesas AS NUMERIC), 4) AS CRECIMIENTO_VS_AA_MESAS,
  ROUND(SAFE_CAST(Crecimiento_vs_MA_Mesas AS NUMERIC), 4) AS CRECIMIENTO_VS_MA_MESAS,
  ROUND(SAFE_CAST(TM_sobre_WT_Mesas__FP_CC_ AS NUMERIC), 4) AS TM_SOBRE_WT_MESAS_FP_CC,
  ROUND(SAFE_CAST(TM_sobre_WT_Mesas__CC_ AS NUMERIC), 4) AS TM_SOBRE_WT_MESAS_CC,
  ROUND(SAFE_CAST(Clientes_Activos_Mesas AS NUMERIC), 4) AS CLIENTES_ACTIVOS_MESAS,
  ROUND(SAFE_CAST(Clientes_Activos_Cartera_Mesas AS NUMERIC), 4) AS CLIENTES_ACTIVOS_CARTERA_MESAS,
  ROUND(SAFE_CAST(Contribucion_WT_Cartera_a_LDN_Mesas AS NUMERIC), 4) AS CONTRIBUCION_WT_CARTERA_A_LDN_MESAS,
  ROUND(SAFE_CAST(CC_FP__Costo_Mesas_ AS NUMERIC), 4) AS CC_FP_COSTO_MESAS,
  ROUND(SAFE_CAST(CR_Mesas AS NUMERIC), 4) AS CR_MESAS,
  ROUND(SAFE_CAST(CR_Cash_Back_Mesas AS NUMERIC), 4) AS CR_CASH_BACK_MESAS,
  ROUND(SAFE_CAST(CR_Discrecional_Mesas AS NUMERIC), 4) AS CR_DISCRECIONAL_MESAS,
  ROUND(SAFE_CAST(CR_Sorteos_Mesas AS NUMERIC), 4) AS CR_SORTEOS_MESAS,
  ROUND(SAFE_CAST(FNR_Mesas AS NUMERIC), 4) AS FNR_MESAS,
  ROUND(SAFE_CAST(FNR_Cash_Back_Mesas AS NUMERIC), 4) AS FNR_CASH_BACK_MESAS,
  ROUND(SAFE_CAST(FNR_Discrecional_EH_Mesas AS NUMERIC), 4) AS FNR_DISCRECIONAL_EH_MESAS,
  ROUND(SAFE_CAST(FNR_Discrecional_GDU AS NUMERIC), 4) AS FNR_DISCRECIONAL_GDU,
  ROUND(SAFE_CAST(FNR_Promociones_Generales AS NUMERIC), 4) AS FNR_PROMOCIONES_GENERALES,
  ROUND(SAFE_CAST(Puntos_A_Mesas AS NUMERIC), 4) AS PUNTOS_A_MESAS,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Discrecional_EH_EDC_Mesas AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_DISCRECIONAL_EH_EDC_MESAS,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Discrecional_GDM AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_DISCRECIONAL_GDM,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Poker_Room AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_POKER_ROOM,
  ROUND(SAFE_CAST(Puntos_A_Cortesias_Orientales_Mesas AS NUMERIC), 4) AS PUNTOS_A_CORTESIAS_ORIENTALES_MESAS,
  ROUND(SAFE_CAST(Evaluacion_CB_Slots AS NUMERIC), 4) AS EVALUACION_CB_SLOTS,
  ROUND(SAFE_CAST(Clientes_en_Listado_Slots AS NUMERIC), 4) AS CLIENTES_EN_LISTADO_SLOTS,
  ROUND(SAFE_CAST(Clientes_con_Promocion_Slots AS NUMERIC), 4) AS CLIENTES_CON_PROMOCION_SLOTS,
  ROUND(SAFE_CAST(ROI_Delta_CB_Slots AS NUMERIC), 4) AS ROI_DELTA_CB_SLOTS,
  ROUND(SAFE_CAST(Evaluacion_CB_Mesas AS NUMERIC), 4) AS EVALUACION_CB_MESAS,
  ROUND(SAFE_CAST(Clientes_en_Listado_Mesas AS NUMERIC), 4) AS CLIENTES_EN_LISTADO_MESAS,
  ROUND(SAFE_CAST(Clientes_con_Promocion_Mesas AS NUMERIC), 4) AS CLIENTES_CON_PROMOCION_MESAS,
  ROUND(SAFE_CAST(ROI_Delta_Mesas AS NUMERIC), 4) AS ROI_DELTA_MESAS,
  ROUND(SAFE_CAST(Evaluacion_Partcipa___Gana AS NUMERIC), 4) AS EVALUACION_PARTCIPA_GANA,
  ROUND(SAFE_CAST(Clientes_con_Promocion_Participa___Gana AS NUMERIC), 4) AS CLIENTES_CON_PROMOCION_PARTICIPA_GANA,
  ROUND(SAFE_CAST(Entregas_por_Cliente AS NUMERIC), 4) AS ENTREGAS_POR_CLIENTE,
  ROUND(SAFE_CAST(ROI_Delta_Participa___Gana AS NUMERIC), 4) AS ROI_DELTA_PARTICIPA_GANA,
  ROUND(SAFE_CAST(Evaluacion_Sorteos AS NUMERIC), 4) AS EVALUACION_SORTEOS,
  ROUND(SAFE_CAST(Clientes_con_Folios AS NUMERIC), 4) AS CLIENTES_CON_FOLIOS,
  ROUND(SAFE_CAST(Participacion_Sorteos AS NUMERIC), 4) AS PARTICIPACION_SORTEOS,
  ROUND(SAFE_CAST(__Sorteos AS NUMERIC), 4) AS SORTEOS,
  ROUND(SAFE_CAST(__Sorteos_Rentables AS NUMERIC), 4) AS SORTEOS_RENTABLES,
  ROUND(SAFE_CAST(ROI_Delta_Sorteos AS NUMERIC), 4) AS ROI_DELTA_SORTEOS,
  ROUND(SAFE_CAST(Eventos AS NUMERIC), 4) AS EVENTOS,
  ROUND(SAFE_CAST(Activaciones AS NUMERIC), 4) AS ACTIVACIONES,
  ROUND(SAFE_CAST(Gastos_Genericos AS NUMERIC), 4) AS GASTOS_GENERICOS,
  ROUND(SAFE_CAST(Decoracion_Institucional AS NUMERIC), 4) AS DECORACION_INSTITUCIONAL,
  ROUND(SAFE_CAST(Evaluacion_Discrecional_Slots AS NUMERIC), 4) AS EVALUACION_DISCRECIONAL_SLOTS,
  ROUND(SAFE_CAST(Clientes_en_Cartera AS NUMERIC), 4) AS CLIENTES_EN_CARTERA,
  ROUND(SAFE_CAST(Clientes_Activos AS NUMERIC), 4) AS CLIENTES_ACTIVOS,
  ROUND(SAFE_CAST(Clientes_con_Discrecional AS NUMERIC), 4) AS CLIENTES_CON_DISCRECIONAL,
  ROUND(SAFE_CAST(Participacion_Descrecional_Slots AS NUMERIC), 4) AS PARTICIPACION_DESCRECIONAL_SLOTS,
  ROUND(SAFE_CAST(Costo_por_Cliente AS NUMERIC), 4) AS COSTO_POR_CLIENTE,
  ROUND(SAFE_CAST(ROI_Delta_Discrecional_Slots AS NUMERIC), 4) AS ROI_DELTA_DISCRECIONAL_SLOTS,
  ROUND(SAFE_CAST(Estrategia AS NUMERIC), 4) AS ESTRATEGIA,
  ROUND(SAFE_CAST(Atraccion AS NUMERIC), 4) AS ATRACCION,
  ROUND(SAFE_CAST(Atraccion_Retencion AS NUMERIC), 4) AS ATRACCION_RETENCION,
  ROUND(SAFE_CAST(Retencion AS NUMERIC), 4) AS RETENCION,
  ROUND(SAFE_CAST(Recuperacion AS NUMERIC), 4) AS RECUPERACION,
  ROUND(SAFE_CAST(Otros AS NUMERIC), 4) AS OTROS,
  ROUND(SAFE_CAST(Publicidad AS NUMERIC), 4) AS PUBLICIDAD,
  ROUND(SAFE_CAST(Digital AS NUMERIC), 4) AS DIGITAL,
  ROUND(SAFE_CAST(Tradicional AS NUMERIC), 4) AS TRADICIONAL,
  ROUND(SAFE_CAST(Dirigidas_Centric_Nuevos AS NUMERIC), 4) AS DIRIGIDAS_CENTRIC_NUEVOS,
  ROUND(SAFE_CAST(Dirigidas_Centric_Mantenimiento AS NUMERIC), 4) AS DIRIGIDAS_CENTRIC_MANTENIMIENTO,
  ROUND(SAFE_CAST(Costo_Ingreso AS NUMERIC), 4) AS COSTO_INGRESO,
  ROUND(SAFE_CAST(Gasto_Adiquision_Puro AS NUMERIC), 4) AS GASTO_ADIQUISION_PURO,
  ROUND(SAFE_CAST(Gasto_Adiquision AS NUMERIC), 4) AS GASTO_ADIQUISION,
  ROUND(SAFE_CAST(Gasto_Manteminiento_Puro AS NUMERIC), 4) AS GASTO_MANTEMINIENTO_PURO,
  ROUND(SAFE_CAST(Gasto_Manteminiento AS NUMERIC), 4) AS GASTO_MANTEMINIENTO,
  ROUND(SAFE_CAST(CCA_Puro AS NUMERIC), 4) AS CCA_PURO,
  ROUND(SAFE_CAST(CCA AS NUMERIC), 4) AS CCA,
  ROUND(SAFE_CAST(CC_Mantenimiento AS NUMERIC), 4) AS CC_MANTENIMIENTO,
  ROUND(SAFE_CAST(CT_x_Cliente AS NUMERIC), 4) AS CT_X_CLIENTE,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_TABLERO_TM_CONSOLIDADO_RAW`