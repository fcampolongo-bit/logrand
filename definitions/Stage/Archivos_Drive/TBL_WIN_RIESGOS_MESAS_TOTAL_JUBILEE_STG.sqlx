config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_WIN_RIESGOS_MESAS_TOTAL_JUBILEE_STG",
  bigquery: {
    clusterBy: ["FECHA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(FECHA AS DATE) AS FECHA,
  SAFE_CAST(DIA AS DATE) AS DIA,
  ROUND(SAFE_CAST(BLACK_JACK_1 AS NUMERIC), 2) AS BLACK_JACK_1,
  ROUND(SAFE_CAST(BLACK_JACK_6 AS NUMERIC), 2) AS BLACK_JACK_6,
  ROUND(SAFE_CAST(BLACK_JACK_7 AS NUMERIC), 2) AS BLACK_JACK_7,
  ROUND(SAFE_CAST(BLACK_JACK_8 AS NUMERIC), 2) AS BLACK_JACK_8,
  ROUND(SAFE_CAST(BLACK_JACK_9 AS NUMERIC), 2) AS BLACK_JACK_9,
  ROUND(SAFE_CAST(BLACK_JACK_10 AS NUMERIC), 2) AS BLACK_JACK_10,
  ROUND(SAFE_CAST(CRAPS_2 AS NUMERIC), 2) AS CRAPS_2,
  ROUND(SAFE_CAST(CRAPS_3 AS NUMERIC), 2) AS CRAPS_3,
  ROUND(SAFE_CAST(RULETA_1 AS NUMERIC), 2) AS RULETA_1,
  ROUND(SAFE_CAST(RULETA_2 AS NUMERIC), 2) AS RULETA_2,
  ROUND(SAFE_CAST(MIDI_BACCARAT_1 AS NUMERIC), 2) AS MIDI_BACCARAT_1,
  ROUND(SAFE_CAST(THREE_CARD_POKER_2 AS NUMERIC), 2) AS THREE_CARD_POKER_2,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_1 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_1,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_2 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_2,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_3 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_3,
  ROUND(SAFE_CAST(CRAZY_4_POKER_1 AS NUMERIC), 2) AS CRAZY_4_POKER_1,
  ROUND(SAFE_CAST(BLACK_JACK_SWITCH_1 AS NUMERIC), 2) AS BLACK_JACK_SWITCH_1,
  ROUND(SAFE_CAST(CRAZY_4_POKER_2 AS NUMERIC), 2) AS CRAZY_4_POKER_2,
  ROUND(SAFE_CAST(BJ_ZAPPIT_1 AS NUMERIC), 2) AS BJ_ZAPPIT_1,
  ROUND(SAFE_CAST(DJ_WILD_1 AS NUMERIC), 2) AS DJ_WILD_1,
  ROUND(SAFE_CAST(BJ_ZOMBIE_1 AS NUMERIC), 2) AS BJ_ZOMBIE_1,
  ROUND(SAFE_CAST(BLACK_JACK_VIP AS NUMERIC), 2) AS BLACK_JACK_VIP,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_VIP AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_VIP,
  ROUND(SAFE_CAST(RULETA_VIP AS NUMERIC), 2) AS RULETA_VIP,
  ROUND(SAFE_CAST(CRAPS_VIP AS NUMERIC), 2) AS CRAPS_VIP,
  ROUND(SAFE_CAST(BLACK_JACK_VIP2 AS NUMERIC), 2) AS BLACK_JACK_VIP2,
  ROUND(SAFE_CAST(MIDI_BACCARAT_VIP AS NUMERIC), 2) AS MIDI_BACCARAT_VIP,
  ROUND(SAFE_CAST(MIDI_BACCARAT_VIP2 AS NUMERIC), 2) AS MIDI_BACCARAT_VIP2,
  ROUND(SAFE_CAST(RULETA_3 AS NUMERIC), 2) AS RULETA_3,
  ROUND(SAFE_CAST(RULETA_4 AS NUMERIC), 2) AS RULETA_4,
  ROUND(SAFE_CAST(CRAPS_4 AS NUMERIC), 2) AS CRAPS_4,
  ROUND(SAFE_CAST(THREE_CARD_POKER AS NUMERIC), 2) AS THREE_CARD_POKER,
  ROUND(SAFE_CAST(CRAZY_4_POKER_3 AS NUMERIC), 2) AS CRAZY_4_POKER_3,
  ROUND(SAFE_CAST(BLACK_JACK_12 AS NUMERIC), 2) AS BLACK_JACK_12,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_4 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_4,
  ROUND(SAFE_CAST(TEXAS_HOLDEM_1 AS NUMERIC), 2) AS TEXAS_HOLDEM_1,
  ROUND(SAFE_CAST(MIDI_BACCARAT_VIP_4 AS NUMERIC), 2) AS MIDI_BACCARAT_VIP_4,
  ROUND(SAFE_CAST(MIDI_BACCARAT_12 AS NUMERIC), 2) AS MIDI_BACCARAT_12,
  ROUND(SAFE_CAST(ULTIMATE_TEXAS_HOLDEM_5 AS NUMERIC), 2) AS ULTIMATE_TEXAS_HOLDEM_5,
  ROUND(SAFE_CAST(MIDI_BACCARAT_13 AS NUMERIC), 2) AS MIDI_BACCARAT_13,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_WIN_RIESGOS_MESAS_TOTAL_JUBILEE_RAW`