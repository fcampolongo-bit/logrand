config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_BASE_MB51_2026_STG",
  bigquery: {
    clusterBy: ["CENTRO"]
  },
  tags: ["carga_full_semanal_stg_archivos"]
}

SELECT
  SAFE_CAST(Centro AS INT64) AS CENTRO,
  SAFE_CAST(ROUND(SAFE_CAST(REGEXP_REPLACE(Almacen, r'[^0-9.\-]', '') AS NUMERIC)) AS INT64) AS ALMACEN,
  SAFE_CAST(Documento_material AS INT64) AS DOCUMENTO_MATERIAL,
  SAFE_CAST(Posicion_doc_mat_ AS INT64) AS POSICION_DOC_MAT,
  SAFE_CAST(Clase_de_movimiento AS INT64) AS CLASE_DE_MOVIMIENTO,
  SAFE_CAST(Texto_de_clase_de_movimiento AS STRING) AS TEXTO_DE_CLASE_DE_MOVIMIENTO,
  SAFE_CAST(Pedido AS INT64) AS PEDIDO,
  SAFE_CAST(Posicion AS INT64) AS POSICION,
  SAFE_CAST(ROUND(SAFE_CAST(REGEXP_REPLACE(Proveedor, r'[^0-9.\-]', '') AS NUMERIC)) AS INT64) AS PROVEEDOR,
  SAFE_CAST(No_reserva AS INT64) AS N_RESERVA,
  SAFE_CAST(No_pos_reserva_traslado AS INT64) AS N_POS_RESERVA_TRASLADO,
  SAFE_CAST(Fecha_de_documento AS DATE) AS FECHA_DE_DOCUMENTO,
  SAFE_CAST(Fe_contabilizacion AS DATE) AS FE_CONTABILIZACION,
  SAFE_CAST(ROUND(SAFE_CAST(Material AS NUMERIC)) AS INT64) AS MATERIAL,
  SAFE_CAST(Texto_breve_de_material AS STRING) AS TEXTO_BREVE_DE_MATERIAL,
  SAFE_CAST(Unidad_medida_base AS STRING) AS UNIDAD_MEDIDA_BASE,
  ROUND(SAFE_CAST(Cantidad AS NUMERIC), 3) AS CANTIDAD,
  SAFE_CAST(Un_medida_de_entrada AS STRING) AS UN_MEDIDA_DE_ENTRADA,
  ROUND(SAFE_CAST(Ctd_en_UM_entrada AS NUMERIC), 3) AS CTD_EN_UM_ENTRADA,
  SAFE_CAST(Unidad_medida_pedido AS STRING) AS UNIDAD_MEDIDA_PEDIDO,
  ROUND(SAFE_CAST(Cantidad_en_UM_ped_ AS NUMERIC), 3) AS CANTIDAD_EN_UM_PED,
  SAFE_CAST(Centro_de_coste AS STRING) AS CENTRO_DE_COSTE,
  SAFE_CAST(Nombre_del_usuario AS STRING) AS NOMBRE_DEL_USUARIO,
  SAFE_CAST(Motivo_movimiento AS INT64) AS MOTIVO_MOVIMIENTO,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_BASE_MB51_2026_RAW`