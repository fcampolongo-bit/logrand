config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_CONSUMOS_ACR_HISTORICO_STG",
  bigquery: {
    clusterBy: ["CENTRO"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Centro AS STRING) AS CENTRO,
  SAFE_CAST(Material AS INT64) AS MATERIAL,
  SAFE_CAST(Texto_breve_de_material AS STRING) AS TEXTO_BREVE_DE_MATERIAL,
  ROUND(SAFE_CAST(Ctd_en_UM_entrada AS NUMERIC), 2) AS CTD_EN_UM_ENTRADA,
  ROUND(SAFE_CAST(Importe_ML AS NUMERIC), 2) AS IMPORTE_ML,
  SAFE_CAST(Fecha_de_entrada AS DATE) AS FECHA_DE_ENTRADA,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_CONSUMOS_ACR_HISTORICO_RAW`