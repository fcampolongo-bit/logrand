config {
  type: "table",
  database: databases.stage,
  schema: "STG_CADENA_DE_SUMINISTRO",
  name: "TBL_BASE_ME2N_2026_STG",
  bigquery: {
    clusterBy: ["CONCATENAR"]
  },
  tags: ["carga_full_semanal_stg_archivos"]
}

SELECT
  SAFE_CAST(concatenar AS INT64) AS CONCATENAR,
  DATE_ADD(DATE '1899-12-30', INTERVAL SAFE_CAST(fecha_de_entrada AS INT64) DAY) AS FECHA_DE_ENTRADA,
  SAFE_CAST(Cl_documento_compras AS STRING) AS CL_DOCUMENTO_COMPRAS,
  SAFE_CAST(Tipo_doc_compras AS STRING) AS TIPO_DOC_COMPRAS,
  SAFE_CAST(ROUND(SAFE_CAST(Contrato_marco AS NUMERIC)) AS INT64) AS CONTRATO_MARCO,
  SAFE_CAST(Pos_contrato_sup_ AS INT64) AS POS_CONTRATO_SUP,
  SAFE_CAST(ROUND(SAFE_CAST(REGEXP_REPLACE(Grupo_de_compras, r'[^0-9.\-]', '') AS NUMERIC)) AS INT64) AS GRUPO_DE_COMPRAS,
  ROUND(SAFE_CAST(Por_entregar__cantidad_ AS NUMERIC), 3) AS POR_ENTREGAR_CANTIDAD,
  SAFE_CAST(Fecha_documento AS DATE) AS FECHA_DOCUMENTO,
  SAFE_CAST(Proveedor_Centro_suministrador AS STRING) AS PROVEEDOR_CENTRO_SUMINISTRADOR,
  SAFE_CAST(ROUND(SAFE_CAST(Material AS NUMERIC)) AS INT64) AS MATERIAL,
  SAFE_CAST(Texto_breve AS STRING) AS TEXTO_BREVE,
  SAFE_CAST(Grupo_de_articulos AS STRING) AS GRUPO_DE_ARTICULOS,
  SAFE_CAST(Indicador_de_borrado AS STRING) AS INDICADOR_DE_BORRADO,
  SAFE_CAST(Tipo_de_posicion AS STRING) AS TIPO_DE_POSICION,
  SAFE_CAST(Tipo_de_imputacion AS STRING) AS TIPO_DE_IMPUTACION,
  SAFE_CAST(Centro AS INT64) AS CENTRO,
  SAFE_CAST(Almacen AS STRING) AS ALMACEN,
  ROUND(SAFE_CAST(Cantidad_de_pedido AS NUMERIC), 3) AS CANTIDAD_DE_PEDIDO,
  SAFE_CAST(Unidad_medida_pedido AS STRING) AS UNIDAD_MEDIDA_PEDIDO,
  ROUND(SAFE_CAST(Precio_neto AS NUMERIC), 2) AS PRECIO_NETO,
  SAFE_CAST(Moneda AS STRING) AS MONEDA,
  ROUND(SAFE_CAST(Cantidad_base AS NUMERIC), 3) AS CANTIDAD_BASE,
  ROUND(SAFE_CAST(Cantidad_de_reparto AS NUMERIC), 3) AS CANTIDAD_DE_REPARTO,
  SAFE_CAST(Fecha_de_entrega AS DATE) AS FECHA_DE_ENTREGA,
  SAFE_CAST(Hora AS TIME) AS HORA,
  SAFE_CAST(Fecha_entrega_estad_ AS DATE) AS FECHA_ENTREGA_ESTAD,
  ROUND(SAFE_CAST(Cantidad_anterior AS NUMERIC), 3) AS CANTIDAD_ANTERIOR,
  ROUND(SAFE_CAST(Cantidad_entrada AS NUMERIC), 3) AS CANTIDAD_ENTRADA,
  ROUND(SAFE_CAST(Cantidad_de_salida AS NUMERIC), 3) AS CANTIDAD_DE_SALIDA,
  ROUND(SAFE_CAST(Cantidad_entregada AS NUMERIC), 3) AS CANTIDAD_ENTREGADA,
  SAFE_CAST(ROUND(SAFE_CAST(Solicitud_de_pedido AS NUMERIC)) AS INT64) AS SOLICITUD_DE_PEDIDO,
  SAFE_CAST(Pos_solicitud_pedido AS INT64) AS POS_SOLICITUD_PEDIDO,
  SAFE_CAST(Indicador_creacion AS STRING) AS INDICADOR_CREACION,
  SAFE_CAST(Cantidad_de_posiciones AS INT64) AS CANTIDAD_DE_POSICIONES,
  SAFE_CAST(Reparto AS INT64) AS REPARTO,
  SAFE_CAST(Documento_compras AS INT64) AS DOCUMENTO_COMPRAS,
  SAFE_CAST(Posicion AS INT64) AS POSICION,
  SAFE_CAST(Urgencia_necesidad AS INT64) AS URGENCIA_NECESIDAD,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_BASE_ME2N_2026_RAW`