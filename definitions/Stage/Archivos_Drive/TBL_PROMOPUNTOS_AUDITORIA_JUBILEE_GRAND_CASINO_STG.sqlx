config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_PROMOPUNTOS_AUDITORIA_JUBILEE_GRAND_CASINO_STG",
  bigquery: {
    clusterBy: ["FECHA", "SALA"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Fecha AS DATE) AS FECHA,
  SAFE_CAST(Sala AS STRING) AS SALA,
  SAFE_CAST(Proveedor_Promopuntos AS STRING) AS PROVEEDOR_PROMOPUNTOS,
  SAFE_CAST(Nombre_Promopuntos AS STRING) AS NOMBRE_PROMOPUNTOS,
  SAFE_CAST(ID_en_planta_Promopuntos AS STRING) AS ID_EN_PLANTA_PROMOPUNTOS,
  SAFE_CAST(Iniciada_Promopuntos AS TIMESTAMP) AS INICIADA_PROMOPUNTOS,
  SAFE_CAST(Finalizada_Promopuntos AS TIMESTAMP) AS FINALIZADA_PROMOPUNTOS,
  SAFE_CAST(Duracion_Promopuntos AS STRING) AS DURACION_PROMOPUNTOS,
  SAFE_CAST(Estado_Promopuntos AS STRING) AS ESTADO_PROMOPUNTOS,
  ROUND(SAFE_CAST(Numero_Promopuntos AS NUMERIC), 2) AS NUMERO_PROMOPUNTOS,
  SAFE_CAST(Titular_Promopuntos AS STRING) AS TITULAR_PROMOPUNTOS,
  ROUND(SAFE_CAST(Total_in_Promopuntos AS NUMERIC), 2) AS TOTAL_IN_PROMOPUNTOS,
  ROUND(SAFE_CAST(Jugado_Promopuntos AS NUMERIC), 2) AS JUGADO_PROMOPUNTOS,
  ROUND(SAFE_CAST(Ganado_Promopuntos AS NUMERIC), 2) AS GANADO_PROMOPUNTOS,
  ROUND(SAFE_CAST(Total_out_Promopuntos AS NUMERIC), 2) AS TOTAL_OUT_PROMOPUNTOS,
  ROUND(SAFE_CAST(Netwin_Promopuntos AS NUMERIC), 2) AS NETWIN_PROMOPUNTOS,
  ROUND(SAFE_CAST(Calculados_Promopuntos AS NUMERIC), 2) AS CALCULADOS_PROMOPUNTOS,
  ROUND(SAFE_CAST(Asignados_Promopuntos AS NUMERIC), 2) AS ASIGNADOS_PROMOPUNTOS,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_PROMOPUNTOS_AUDITORIA_JUBILEE_GRAND_CASINO_RAW`