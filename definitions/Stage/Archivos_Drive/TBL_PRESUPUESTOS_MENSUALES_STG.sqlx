config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_PRESUPUESTOS_MENSUALES_STG",
  bigquery: {
    clusterBy: ["YEAR", "MONTH"]
  },
  tags: ["carga_full_anual_stg_archivos"]
}

SELECT
  SAFE_CAST(Year AS INT64) AS YEAR,
  SAFE_CAST(Month AS INT64) AS MONTH,
  SAFE_CAST(Sala AS STRING) AS SALA,
  ROUND(SAFE_CAST(Ppto_coin_in AS NUMERIC), 4) AS PPTO_COIN_IN,
  ROUND(SAFE_CAST(Ppto_coin_in_red AS NUMERIC), 4) AS PPTO_COIN_IN_RED,
  ROUND(SAFE_CAST(Ppto_netwin AS NUMERIC), 4) AS PPTO_NETWIN,
  ROUND(SAFE_CAST(Ppto_netwin_red AS NUMERIC), 4) AS PPTO_NETWIN_RED,
  ROUND(SAFE_CAST(Ppto_drop AS NUMERIC), 4) AS PPTO_DROP,
  ROUND(SAFE_CAST(Ppto_win_mesas AS NUMERIC), 4) AS PPTO_WIN_MESAS,
  ROUND(SAFE_CAST(Ppto_entrada_maquinas AS NUMERIC), 4) AS PPTO_ENTRADA_MAQUINAS,
  ROUND(SAFE_CAST(Ppto_entrada_mesas AS NUMERIC), 4) AS PPTO_ENTRADA_MESAS,
  ROUND(SAFE_CAST(Ppto_resultado_maquinas AS NUMERIC), 4) AS PPTO_RESULTADO_MAQUINAS,
  ROUND(SAFE_CAST(Ppto_resultado_mesas AS NUMERIC), 4) AS PPTO_RESULTADO_MESAS,
  ROUND(SAFE_CAST(Ppto_ayb AS NUMERIC), 4) AS PPTO_AYB,
  ROUND(SAFE_CAST(Ppto_tfp_ayb AS NUMERIC), 4) AS PPTO_TFP_AYB,
  ROUND(SAFE_CAST(Ppto_GGR_OTC AS NUMERIC), 4) AS PPTO_GGR_OTC,
  ROUND(SAFE_CAST(Ppto_GGR_Plataforma_Afiliados AS NUMERIC), 4) AS PPTO_GGR_PLATAFORMA_AFILIADOS,
  ROUND(SAFE_CAST(Ppto_GGR_Plataforma_Campanas_P AS NUMERIC), 4) AS PPTO_GGR_PLATAFORMA_CAMPANAS_P,
  ROUND(SAFE_CAST(Ppto_GGR_Plataforma_Salas AS NUMERIC), 4) AS PPTO_GGR_PLATAFORMA_SALAS,
  ROUND(SAFE_CAST(Ppto_GGR_Casino_Afiliados AS NUMERIC), 4) AS PPTO_GGR_CASINO_AFILIADOS,
  ROUND(SAFE_CAST(Ppto_GGR_Casino_Campanas AS NUMERIC), 4) AS PPTO_GGR_CASINO_CAMPANAS,
  ROUND(SAFE_CAST(Ppto_GGR_Casino_Salas AS NUMERIC), 4) AS PPTO_GGR_CASINO_SALAS,
  ROUND(SAFE_CAST(Ppto_Depositos_Tarjetas AS NUMERIC), 4) AS PPTO_DEPOSITOS_TARJETAS,
  ROUND(SAFE_CAST(Ppto_Depositos_Tiendas AS NUMERIC), 4) AS PPTO_DEPOSITOS_TIENDAS,
  ROUND(SAFE_CAST(Ppto_Depositos_SPEI AS NUMERIC), 4) AS PPTO_DEPOSITOS_SPEI,
  ROUND(SAFE_CAST(Ppto_Retiros AS NUMERIC), 4) AS PPTO_RETIROS,
  ROUND(SAFE_CAST(Ppto_Conversion_Bonos AS NUMERIC), 4) AS PPTO_CONVERSION_BONOS,
  ROUND(SAFE_CAST(Ppto_Charge_back AS NUMERIC), 4) AS PPTO_CHARGE_BACK,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_PRESUPUESTOS_MENSUALES_RAW`