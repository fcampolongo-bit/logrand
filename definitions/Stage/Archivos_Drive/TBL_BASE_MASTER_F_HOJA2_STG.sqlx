config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_BASE_MASTER_F_HOJA2_STG",
  bigquery: {
    clusterBy: ["YEAR", "MES"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(YEAR AS INT64) AS YEAR,
  SAFE_CAST(Mes AS STRING) AS MES,
  SAFE_CAST(Salas AS STRING) AS SALAS,
  SAFE_CAST(ID_de_Orden_de_Trabajo AS STRING) AS ID_DE_ORDEN_DE_TRABAJO,
  SAFE_CAST(Estado AS STRING) AS ESTADO,
  SAFE_CAST(Codigo AS STRING) AS CODIGO,
  SAFE_CAST(Activo AS STRING) AS ACTIVO,
  SAFE_CAST(Fuera_de_servicio AS STRING) AS FUERA_DE_SERVICIO,
  SAFE_CAST(Tarea AS STRING) AS TAREA,
  SAFE_CAST(Activador AS STRING) AS ACTIVADOR,
  SAFE_CAST(Ubicado_en_o_es_Parte_de AS STRING) AS UBICADO_EN_O_ES_PARTE_DE,
  SAFE_CAST(Tipo_de_Activo AS STRING) AS TIPO_DE_ACTIVO,
  SAFE_CAST(Estado_de_la_Tarea AS STRING) AS ESTADO_DE_LA_TAREA,
  SAFE_CAST(Tarea_Duracion_Estimada AS STRING) AS TAREA_DURACION_ESTIMADA,
  SAFE_CAST(Tiempo_de_Ejecucion AS STRING) AS TIEMPO_DE_EJECUCION,
  SAFE_CAST(Tipo_de_Tarea AS STRING) AS TIPO_DE_TAREA,
  SAFE_CAST(Fecha_Programada AS TIMESTAMP) AS FECHA_PROGRAMADA,
  SAFE_CAST(Fecha_de_Inicio AS TIMESTAMP) AS FECHA_DE_INICIO,
  SAFE_CAST(Fecha_Final AS TIMESTAMP) AS FECHA_FINAL,
  SAFE_CAST(Fecha_de_creacion_de_la_OT AS TIMESTAMP) AS FECHA_DE_CREACION_DE_LA_OT,
  SAFE_CAST(Fecha_de_cierre_de_la_OT AS TIMESTAMP) AS FECHA_DE_CIERRE_DE_LA_OT,
  SAFE_CAST(Paro_de_equipo AS STRING) AS PARO_DE_EQUIPO,
  SAFE_CAST(Tiempo_de_Paro_por_Mantenimiento_Planificado AS STRING) AS TIEMPO_DE_PARO_POR_MANTENIMIENTO_PLANIFICADO,
  ROUND(SAFE_CAST(Horas_Totales AS NUMERIC), 4) AS HORAS_TOTALES,
  SAFE_CAST(Recursos_Humanos AS STRING) AS RECURSOS_HUMANOS,
  SAFE_CAST(Responsable AS STRING) AS RESPONSABLE,
  SAFE_CAST(Creada_por AS STRING) AS CREADA_POR,
  SAFE_CAST(Tarea_Prioridad AS STRING) AS TAREA_PRIORIDAD,
  SAFE_CAST(Fecha_del_Incidente AS TIMESTAMP) AS FECHA_DEL_INCIDENTE,
  SAFE_CAST(ROUND(SAFE_CAST(Numero_de_Solicitud AS NUMERIC)) AS INT64) AS NUMERO_DE_SOLICITUD,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_BASE_MASTER_F_HOJA2_RAW`