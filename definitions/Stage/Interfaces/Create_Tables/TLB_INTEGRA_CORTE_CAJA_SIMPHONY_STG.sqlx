config {
  type: "table",
  database: databases.stage,
  schema: "STG_INTERFACES",
  name: "TBL_INTEGRA_CORTE_CAJA_SIMPHONY_STG",
  tags: ["carga_full_diaria_stg_interfaces"]
}

SELECT
  FechaProceso,
  Sala,
  CentroConsumo,
  Forma_Pago,
  Monto,
  CURRENT_TIMESTAMP() AS ingestion_ts
FROM
  ${ref(databases.raw, "STG_INTERFACES", "TBL_INTEGRA_CORTE_CAJA_SIMPHONY_RAW")}
