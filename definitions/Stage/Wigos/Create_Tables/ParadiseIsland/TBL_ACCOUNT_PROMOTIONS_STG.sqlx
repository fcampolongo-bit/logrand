
config {
  type: "incremental",
  database: databases.stage,
  schema: "STG_WIGOS_PARADISEISLAND",
  name: "TBL_ACCOUNT_PROMOTIONS_STG",
  uniqueKey: ["acp_unique_id"],
  partitionBy: "DATE(acp_created)",
  updatePartitionFilter: "acp_created >= datetime_sub(current_datetime(), interval 12 day)",
  clusterBy: ["acp_promo_id", "acp_status", "acp_account_id", "acp_operation_id"],
  tags: ["carga_incremental_diaria_stg_paradiseisland"]
}

SELECT
  acp_unique_id,
  acp_created,
  acp_account_id,
  acp_account_level,
  acp_promo_type,
  acp_promo_id,
  acp_promo_name,
  acp_promo_date,
  acp_operation_id,
  acp_credit_type,
  acp_activation,
  acp_expiration,
  acp_cash_in,
  acp_points,
  acp_ini_balance,
  acp_ini_withhold,
  acp_ini_wonlock,
  acp_balance,
  acp_withhold,
  acp_wonlock,
  acp_played,
  acp_won,
  acp_status,
  acp_updated,
  acp_play_session_id,
  acp_transaction_id,
  acp_recommended_account_id,
  acp_details,
  acp_promo_category_id,
  acp_redeemable_cost,
  acp_prize_type,
  acp_prize_gross,
  acp_prize_tax1,
  acp_prize_tax2,
  acp_prize_tax3,
  acp_pyramid_prize,
  acp_draw_price,
  acp_total_prize,
  acp_prize_tax4,
  acp_prize_tax5,
  acp_promogame_return_price_pct,
  acp_ms_id,
  acp_ms_sequence_id,
  CURRENT_TIMESTAMP() AS ingestion_ts
FROM
  ${ref(databases.raw, "RAW_WIGOS_PARADISEISLAND", "TBL_ACCOUNT_PROMOTIONS_RAW")}