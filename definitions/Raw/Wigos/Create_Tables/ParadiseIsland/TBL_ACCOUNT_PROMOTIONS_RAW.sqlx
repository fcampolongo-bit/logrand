config {
    type: "operations",
    schema: "RAW_WIGOS_PARADISEISLAND",
    name: "TBL_ACCOUNT_PROMOTIONS_RAW",
    database: (databases.raw),
    hasOutput: true
}

CREATE TABLE IF NOT EXISTS ${databases.raw}.RAW_WIGOS_PARADISEISLAND.TBL_ACCOUNT_PROMOTIONS_RAW
(
  acp_unique_id                    INT64      NOT NULL,
  acp_created                      DATETIME   NOT NULL,
  acp_account_id                   INT64      NOT NULL,
  acp_account_level                INT64      NOT NULL,
  acp_promo_type                   INT64      NOT NULL,
  acp_promo_id                     INT64      NOT NULL,
  acp_promo_name                   STRING     NOT NULL,
  acp_promo_date                   DATETIME   NOT NULL,
  acp_operation_id                 INT64      NOT NULL,
  acp_credit_type                  INT64      NOT NULL,
  acp_activation                   DATETIME,
  acp_expiration                   DATETIME,
  acp_cash_in                      NUMERIC,
  acp_points                       NUMERIC,
  acp_ini_balance                  NUMERIC    NOT NULL,
  acp_ini_withhold                 NUMERIC    NOT NULL,
  acp_ini_wonlock                  NUMERIC,
  acp_balance                      NUMERIC    NOT NULL,
  acp_withhold                     NUMERIC    NOT NULL,
  acp_wonlock                      NUMERIC,
  acp_played                       NUMERIC    NOT NULL,
  acp_won                          NUMERIC    NOT NULL,
  acp_status                       INT64      NOT NULL,
  acp_updated                      DATETIME   NOT NULL,
  acp_play_session_id              INT64,
  acp_transaction_id               INT64,
  acp_recommended_account_id       INT64,
  acp_details                      STRING,
  acp_promo_category_id            INT64      NOT NULL,
  acp_redeemable_cost              NUMERIC,
  acp_prize_type                   INT64,
  acp_prize_gross                  NUMERIC,
  acp_prize_tax1                   NUMERIC,
  acp_prize_tax2                   NUMERIC,
  acp_prize_tax3                   NUMERIC,
  acp_pyramid_prize                NUMERIC,
  acp_draw_price                   NUMERIC,
  acp_total_prize                  NUMERIC,
  acp_prize_tax4                   NUMERIC,
  acp_prize_tax5                   NUMERIC,
  acp_promogame_return_price_pct   NUMERIC,
  acp_ms_id                        INT64,
  acp_ms_sequence_id               INT64
)
PARTITION BY DATE(acp_created)
CLUSTER BY acp_promo_id, acp_status, acp_account_id, acp_operation_id;