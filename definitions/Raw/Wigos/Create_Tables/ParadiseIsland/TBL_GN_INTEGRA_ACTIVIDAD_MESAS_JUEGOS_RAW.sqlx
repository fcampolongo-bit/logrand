config {
  type: "operations",
  schema: "RAW_WIGOS_PARADISEISLAND",
  name: "TBL_GN_INTEGRA_ACTIVIDAD_MESAS_JUEGOS_RAW",
  database: (databases.raw),
  hasOutput: true
}

CREATE TABLE IF NOT EXISTS ${databases.raw}.RAW_WIGOS_PARADISEISLAND.TBL_GN_INTEGRA_ACTIVIDAD_MESAS_JUEGOS_RAW
(
  TABLE_IDENTIFIER   INT64 NOT NULL,
  TABLE_NAME         STRING NOT NULL,
  BUY_IN             NUMERIC NOT NULL,
  CHIPS_IN           NUMERIC NOT NULL,
  CHIPS_OUT          NUMERIC NOT NULL,
  GAMES_PLAYED       INT64 NOT NULL,
  NETWIN             NUMERIC NOT NULL,
  THEORIC_HOLD       NUMERIC,
  ISO_CODE           STRING,
  OPEN_HOUR          DATETIME,
  CLOSE_HOUR         DATETIME,
  SESSION_HOURS      INT64
)

PARTITION BY DATE(OPEN_HOUR)
CLUSTER BY TABLE_IDENTIFIER, TABLE_NAME;