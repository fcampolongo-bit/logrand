config {
  type: "table",
  database: databases.stage,
  schema: "STG_DATASET_ARCHIVOS",
  name: "TBL_MODIFICACIONES_SISTEMA_WIGOS_SALA_STG",
  bigquery: {
    clusterBy: ["FECHA", "CASINO"]
  },
  tags: ["carga_full_mensual_stg_archivos"]
}

SELECT
  SAFE_CAST(Fecha AS DATE) AS FECHA,
  SAFE_CAST(CASINO AS STRING) AS CASINO,
  SAFE_CAST(ROUND(SAFE_CAST(_3__DIFERENCIA_CONTADORES_RIESGO_MEDIO AS NUMERIC)) AS INT64) AS COL_3_DIFERENCIA_CONTADORES_RIESGO_MEDIO,
  SAFE_CAST(ROUND(SAFE_CAST(_4__EVENTOS_RIESGO_MEDIO AS NUMERIC)) AS INT64) AS COL_4_EVENTOS_RIESGO_MEDIO,
  SAFE_CAST(ROUND(SAFE_CAST(_5__SESIONES_ABIERTAS__SIN_RIESGO AS NUMERIC)) AS INT64) AS COL_5_SESIONES_ABIERTAS_SIN_RIESGO,
  SAFE_CAST(Numero_de_correcciones_estadisticas AS INT64) AS NUMERO_DE_CORRECCIONES_ESTADISTICAS,
  SAFE_CAST(Numero_de_correcciones_sesiones AS INT64) AS NUMERO_DE_CORRECCIONES_SESIONES,
  CURRENT_TIMESTAMP() AS INGESTION_TS
FROM `logrand-storage-raw-dev.DATASET_ARCHIVOS.TBL_MODIFICACIONES_SISTEMA_WIGOS_SALA_RAW`